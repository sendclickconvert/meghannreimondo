---
import { site, NAV_ITEMS, isTodo } from '../data/site';

// Social icons: linked when a real URL is set; icon-only (no link) while "TODO" per client request.
const socials = [
  { key: 'facebook', label: 'Facebook', href: site.social.facebook, path: 'M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z' },
  { key: 'instagram', label: 'Instagram', href: site.social.instagram, path: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 3.68A6.16 6.16 0 1018.16 12 6.16 6.16 0 0012 5.84zm0 10.16A4 4 0 1116 12a4 4 0 01-4 4zm6.41-10.4a1.44 1.44 0 11-1.44-1.44 1.44 1.44 0 011.44 1.44z' },
  { key: 'nextdoor', label: 'Nextdoor', href: site.social.nextdoor, path: 'M12.026 0C5.4 0 .01 5.407.01 12.014c0 6.606 5.39 11.982 12.016 11.982 6.627 0 12.017-5.376 12.017-11.982C24.043 5.407 18.653 0 12.026 0zm5.297 17.395h-3.181v-6.03a2.075 2.075 0 00-2.073-2.075 2.077 2.077 0 00-2.074 2.074v6.031H6.814v-6.031c0-.529-.4-.969-.925-1.024-1.216-.128-2.24-.968-2.585-2.12l-.208-.695 3.048-.911.207.694a.221.221 0 00.212.157h.85c.309 0 .566-.24.585-.548.19-3.033 2.72-5.443 5.802-5.443 3.207 0 5.813 2.6 5.823 5.807v10.114z' },
  { key: 'bluesky', label: 'Bluesky', href: site.social.bluesky, path: 'M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 01-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z' },
  { key: 'linkedin', label: 'LinkedIn', href: site.social.linkedin, path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z' },
];

// Election-day reminder for the utility bar.
const electionDate = new Date(site.candidate.electionDate + 'T00:00:00');
const electionLabel = electionDate.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
});
---

<header class="sticky top-0 z-50" id="site-header">
  <!-- Top utility bar: race + election-day reminder -->
  <div class="bg-navy text-white text-xs font-heading">
    <div class="container-wide flex items-center justify-between gap-4 py-2">
      <span class="inline-flex items-center gap-1.5 font-semibold uppercase tracking-wide">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Write-In Candidate · General Election {electionLabel}
      </span>
      {socials.length > 0 && (
        <div class="flex items-center gap-2.5 shrink-0">
          {socials.map((s) =>
            isTodo(s.href) ? (
              <span aria-label={s.label} title={s.label} class="inline-flex">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={s.path} /></svg>
              </span>
            ) : (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label} class="hover:opacity-80 transition-opacity">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={s.path} /></svg>
              </a>
            )
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Main nav -->
  <div class="bg-white border-b border-slate-200 shadow-sm">
    <div class="container-wide">
      <nav class="flex items-center justify-between h-20 lg:h-24" aria-label="Primary navigation">
        <!-- Logo: official circular badge when set (render-if-set), else text wordmark -->
        <a href="/" class="flex items-center gap-3 shrink-0" aria-label={`${site.candidate.name} — Home`} title={`${site.candidate.name} — Home`}>
          {site.brand.logo && site.brand.logo !== "TODO" ? (
            <img src={site.brand.logo} alt={`${site.candidate.name} — Write-In for ${site.candidate.office}`} class="h-[4.25rem] lg:h-20 w-auto" /> <!-- sized up per client request (legibility) -->
          ) : (
            <span class="font-display font-extrabold text-lg lg:text-2xl text-navy leading-none">
              {site.candidate.name}
              <span class="block text-[10px] lg:text-xs font-semibold text-red uppercase tracking-widest mt-0.5">{site.brand.tagline}</span>
            </span>
          )}
        </a>

        <!-- Desktop nav -->
        <div class="hidden lg:flex items-center gap-1">
          {NAV_ITEMS.filter((i) => i.href !== '/how-to-vote').map((item) => (
            <a
              href={item.href}
              title={item.label}
              class="px-3 py-2 text-sm font-heading font-semibold text-ink rounded-md hover:text-red transition-colors"
            >
              {item.label}
            </a>
          ))}
        </div>

        <!-- CTA + mobile toggle -->
        <div class="flex items-center gap-3">
          <a href="/how-to-vote" title="How to Write In Meghann Reimondo" class="btn-accent hidden sm:inline-flex text-xs px-5 py-2.5">
            How to Write In
          </a>
          <button
            type="button"
            class="lg:hidden p-2 rounded-md text-ink hover:bg-cream transition-colors"
            aria-label="Open menu"
            id="mobile-menu-toggle"
          >
            <svg class="w-6 h-6" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </nav>
    </div>

    <!-- Mobile menu -->
    <div class="hidden lg:hidden border-t border-slate-200 max-h-[80vh] overflow-y-auto" id="mobile-menu">
      <div class="container-wide py-4 space-y-1">
        {NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            title={item.label}
            class="block px-3 py-2.5 text-sm font-heading font-semibold text-ink rounded-md hover:bg-cream hover:text-red transition-colors"
          >
            {item.label}
          </a>
        ))}
        <div class="pt-3 border-t border-slate-200">
          <a href="/how-to-vote" title="How to Write In Meghann Reimondo" class="btn-accent w-full text-center text-sm">
            How to Write In
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
  });
</script>
