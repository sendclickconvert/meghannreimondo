---
import { site, NAV_ITEMS, isTodo } from '../data/site';

// Social links render only when a real URL is set (never while "TODO").
const socials = [
  { key: 'facebook', href: site.social.facebook, path: 'M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z' },
  { key: 'instagram', href: site.social.instagram, path: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 3.68A6.16 6.16 0 1018.16 12 6.16 6.16 0 0012 5.84zm0 10.16A4 4 0 1116 12a4 4 0 01-4 4zm6.41-10.4a1.44 1.44 0 11-1.44-1.44 1.44 1.44 0 011.44 1.44z' },
].filter((s) => !isTodo(s.href));

// Election-day reminder for the utility bar.
const electionDate = new Date(site.candidate.electionDate + 'T00:00:00');
const electionLabel = electionDate.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
});
---

<header class="sticky top-0 z-50" id="site-header">
  <!-- Top utility bar: race + election-day reminder -->
  <div class="bg-navy text-white text-xs font-heading">
    <div class="container-wide flex items-center justify-between gap-4 py-2">
      <span class="inline-flex items-center gap-1.5 font-semibold uppercase tracking-wide">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Write-In Candidate · General Election {electionLabel}
      </span>
      {socials.length > 0 && (
        <div class="flex items-center gap-2 shrink-0">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.key} class="hover:opacity-80 transition-opacity">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={s.path} /></svg>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>

  <!-- Main nav -->
  <div class="bg-white border-b border-slate-200 shadow-sm">
    <div class="container-wide">
      <nav class="flex items-center justify-between h-16 lg:h-20" aria-label="Primary navigation">
        <!-- Logo (brand logo asset is TODO — text logo for now) -->
        <a href="/" class="flex items-center gap-3 shrink-0" aria-label={`${site.candidate.name} — Home`} title={`${site.candidate.name} — Home`}>
          <span class="font-display font-extrabold text-lg lg:text-2xl text-navy leading-none">
            {site.candidate.name}
            <span class="block text-[10px] lg:text-xs font-semibold text-red uppercase tracking-widest mt-0.5">{site.brand.tagline}</span>
          </span>
        </a>

        <!-- Desktop nav -->
        <div class="hidden lg:flex items-center gap-1">
          {NAV_ITEMS.filter((i) => i.href !== '/how-to-vote').map((item) => (
            <a
              href={item.href}
              title={item.label}
              class="px-3 py-2 text-sm font-heading font-semibold text-ink rounded-md hover:text-red transition-colors"
            >
              {item.label}
            </a>
          ))}
        </div>

        <!-- CTA + mobile toggle -->
        <div class="flex items-center gap-3">
          <a href="/how-to-vote" title="How to Write In Meghann Reimondo" class="btn-accent hidden sm:inline-flex text-xs px-5 py-2.5">
            How to Write In
          </a>
          <button
            type="button"
            class="lg:hidden p-2 rounded-md text-ink hover:bg-cream transition-colors"
            aria-label="Open menu"
            id="mobile-menu-toggle"
          >
            <svg class="w-6 h-6" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </nav>
    </div>

    <!-- Mobile menu -->
    <div class="hidden lg:hidden border-t border-slate-200 max-h-[80vh] overflow-y-auto" id="mobile-menu">
      <div class="container-wide py-4 space-y-1">
        {NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            title={item.label}
            class="block px-3 py-2.5 text-sm font-heading font-semibold text-ink rounded-md hover:bg-cream hover:text-red transition-colors"
          >
            {item.label}
          </a>
        ))}
        <div class="pt-3 border-t border-slate-200">
          <a href="/how-to-vote" title="How to Write In Meghann Reimondo" class="btn-accent w-full text-center text-sm">
            How to Write In
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
  });
</script>
