---
// Visual wallet card (front + back) in campaign colors — navy #012566, red #D60F29.
// The exact, prominent spelling "MEGHANN REIMONDO" is the whole point of the card.
export interface Props {
  print?: boolean; // print layout: fixed card size, no shadows
}
const { print = false } = Astro.props;
const cardBase = print
  ? 'wallet-card-print rounded-xl overflow-hidden border border-slate-300'
  : 'rounded-xl overflow-hidden shadow-soft border border-slate-200 w-full max-w-sm mx-auto';
---

<div class={`grid gap-6 ${print ? 'wallet-print-grid' : 'sm:grid-cols-2 items-stretch'}`}>
  <!-- FRONT -->
  <div class={cardBase} style="aspect-ratio: 1.586;">
    <div class="h-full bg-navy text-white flex flex-col items-center justify-center text-center px-4 py-3 relative">
      <div class="absolute inset-x-0 top-0 h-1.5 bg-red"></div>
      <p class="text-[0.6rem] sm:text-xs font-heading font-bold uppercase tracking-[0.3em] text-red bg-white rounded-full px-3 py-0.5">Write-In</p>
      <p class="mt-2 font-display font-extrabold leading-none text-white text-xl sm:text-2xl tracking-tight uppercase">Meghann<br />Reimondo</p>
      <p class="mt-1.5 text-[0.65rem] sm:text-xs text-white/85 font-heading">for Woodstock Town Supervisor</p>
      <p class="mt-2 text-[0.6rem] sm:text-[0.7rem] italic text-red font-display font-bold bg-white/95 rounded px-2 py-0.5">Leading with Heart</p>
      <div class="absolute inset-x-0 bottom-0 h-1.5 bg-red"></div>
    </div>
  </div>

  <!-- BACK -->
  <div class={cardBase} style="aspect-ratio: 1.586;">
    <div class="h-full bg-white flex flex-col justify-center px-4 py-3 relative">
      <div class="absolute inset-x-0 top-0 h-1.5 bg-navy"></div>
      <p class="text-[0.6rem] sm:text-[0.7rem] font-heading font-bold uppercase tracking-widest text-red">How to write me in</p>
      <ol class="mt-1.5 space-y-1 text-[0.65rem] sm:text-xs text-ink leading-snug">
        <li class="flex gap-1.5"><span class="shrink-0 w-4 h-4 rounded-full bg-navy text-white text-[0.6rem] font-bold flex items-center justify-center">1</span> Find the write-in area at the <strong>bottom of the ballot</strong>, Town Supervisor column</li>
        <li class="flex gap-1.5"><span class="shrink-0 w-4 h-4 rounded-full bg-navy text-white text-[0.6rem] font-bold flex items-center justify-center">2</span> Write in: <strong class="text-navy uppercase">Meghann Reimondo</strong></li>
        <li class="flex gap-1.5"><span class="shrink-0 w-4 h-4 rounded-full bg-navy text-white text-[0.6rem] font-bold flex items-center justify-center">3</span> <strong>Fill it in</strong> to make your vote count</li>
      </ol>
      <div class="absolute inset-x-0 bottom-0 h-1.5 bg-navy"></div>
    </div>
  </div>
</div>
