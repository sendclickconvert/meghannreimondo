---
// Recurring site-wide write-in CTA block — the campaign's strategic spine.
// Content pack §1: for a write-in, the "spelled exactly right" reminder IS the
// whole ballgame, so this block repeats on EVERY page (rendered once, site-wide,
// via BaseLayout, above the footer). Copy is verbatim from the content pack.
import { site } from '../data/site';

export interface Props {
  tone?: 'navy' | 'light'; // navy = solid navy section; light = tinted card
  compact?: boolean;
}
const { tone = 'navy', compact = false } = Astro.props;
const isNavy = tone === 'navy';
---

<section class={isNavy ? 'bg-navy text-white' : 'bg-cream text-ink'}>
  <div class={`container-narrow ${compact ? 'py-8' : 'py-12 lg:py-16'} text-center`}>
    <p class={`font-display font-extrabold ${compact ? 'text-2xl lg:text-3xl' : 'text-3xl lg:text-4xl'} ${isNavy ? 'text-white' : 'text-navy'}`}>
      ✍️ Write in: <span class={isNavy ? 'text-red' : 'text-red'}>Meghann Reimondo</span>
      <span class={`block mt-2 text-lg lg:text-xl font-semibold ${isNavy ? 'text-white/80' : 'text-ink/80'}`}>for {site.candidate.office}.</span>
    </p>
    <p class={`mt-4 text-base lg:text-lg ${isNavy ? 'text-white/75' : 'text-ink/75'} max-w-xl mx-auto`}>
      Spell it exactly: <strong class={isNavy ? 'text-white' : 'text-navy'}>M-E-G-H-A-N-N&nbsp;&nbsp;R-E-I-M-O-N-D-O</strong>, and fill in the oval.
    </p>
    <div class="mt-6">
      <a href="/how-to-vote" class="btn-accent" title="How to write in Meghann Reimondo">How to write her in →</a>
    </div>
  </div>
</section>
