---
// Recurring write-in instruction block — the site's strategic spine.
// Makes the CORRECT spelling "Meghann Reimondo" (double-n) unmissable and
// links to the full How-to-Write-In page + the (TODO) printable wallet card.
import { site } from '../data/site';

export interface Props {
  tone?: 'navy' | 'light'; // navy = solid navy section; light = tinted card
  compact?: boolean;
}
const { tone = 'navy', compact = false } = Astro.props;
const isNavy = tone === 'navy';
---

<section class={isNavy ? 'bg-navy text-white' : 'bg-cream text-ink'}>
  <div class={`container-narrow ${compact ? 'py-8' : 'py-12 lg:py-16'} text-center`}>
    <p class={`text-xs font-heading font-bold uppercase tracking-widest mb-3 ${isNavy ? 'text-red' : 'text-red'}`}>
      Her name is not on the ballot — you write it in
    </p>
    <h2 class={`font-display font-extrabold ${compact ? 'text-2xl lg:text-3xl' : 'text-3xl lg:text-4xl'} ${isNavy ? 'text-white' : 'text-navy'}`}>
      Write in
      <span class={`block mt-2 ${isNavy ? 'text-red' : 'text-red'} tracking-tight`}>Meghann Reimondo</span>
    </h2>
    <p class={`mt-2 font-display font-bold ${compact ? 'text-base' : 'text-lg lg:text-xl'} ${isNavy ? 'text-white/90' : 'text-navy'}`}>
      The &ldquo;write&rdquo; choice for {site.candidate.office.replace('Woodstock ', '')}.
    </p>
    <p class={`mt-3 text-sm ${isNavy ? 'text-white/70' : 'text-ink/70'} max-w-xl mx-auto`}>
      Spell it exactly — <strong class={isNavy ? 'text-white' : 'text-navy'}>M-E-G-H-A-N-N</strong> (double&#8209;n) <strong class={isNavy ? 'text-white' : 'text-navy'}>R-E-I-M-O-N-D-O</strong> — on the {site.candidate.office} write-in line, then fill in the mark so the scanner counts it.
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
      <a href="/how-to-vote" class="btn-accent" title="How to write in Meghann Reimondo">See exactly how to write it in</a>
      <a href="/wallet-card" class={`inline-flex items-center gap-2 font-heading font-bold text-sm underline transition-colors ${isNavy ? 'text-white hover:text-red' : 'text-navy hover:text-red'}`} title="Printable wallet card">
        Download the wallet card
      </a>
    </div>
  </div>
</section>
