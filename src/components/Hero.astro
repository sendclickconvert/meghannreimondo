---
// Campaign hero — split layout: copy on one side, foundation pyramid infographic on the other.
// Per client (7/29/26) the pyramid replaces the campaign video here; the Vimeo URL stays in
// site.media.heroVideo in case it's wanted elsewhere later.
import { site } from '../data/site';
const electionDate = new Date(site.candidate.electionDate + 'T00:00:00');
const electionLabel = electionDate.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
});
---

<section class="relative overflow-hidden bg-white">
  <div class="container-wide py-14 lg:py-20">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <!-- Left: eyebrow + title + text + CTAs -->
      <div>
        <p class="inline-flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-wider text-red bg-red/10 rounded-full px-3 py-1 mb-5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Write-In · General Election {electionLabel}
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold text-navy leading-tight text-balance">
          You Love Woodstock. So&nbsp;Do&nbsp;I.
        </h1>
        <p class="mt-4 text-xl lg:text-2xl text-ink/75 italic text-balance">
          Together we can build a stronger foundation for today and for generations to come.
        </p>
        <p class="mt-5 text-lg text-ink/80 max-w-xl">
          <strong class="text-navy">{site.candidate.name} — the “write” choice for Town Supervisor.</strong><br />
          This November, my name won't be printed on the ballot. You'll need to
          <strong class="text-red">write it in</strong>.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/how-to-vote" class="btn-accent" title="How to write in Meghann Reimondo">How to Write Me In &rarr;</a>
          <a href="/survey" class="inline-flex items-center gap-2 font-heading font-bold text-navy hover:text-red transition-colors underline" title="Take the Community Survey">
            Take the Community Survey &rarr;
          </a>
        </div>
      </div>

      <!-- Right: foundation pyramid infographic (per client 7/29/26 — replaces the campaign video here).
           Native width 1198px; fluid, never upscaled past native. -->
      <div class="mx-auto w-full max-w-[1198px]">
        <picture>
          <source srcset="/images/foundation-pyramid.webp" type="image/webp" />
          <img
            src="/images/foundation-pyramid.png"
            alt="Pyramid diagram titled 'A Strong Foundation Builds Everything That Matters.' From the base up: Our Infrastructure — the foundation (roads, buildings, staff, systems and equipment, culture); Our People and Culture — support for dedicated staff and a respectful work culture; Open Door Leadership — accessible, listening leadership; Opportunity and Growth — responsible economic development, local businesses, recreation, and the arts; and at the top, Thriving Community — a safe, vibrant, connected community where everyone can live, work, and belong. Tagline: Strong Foundations. Smart Decisions. A Better Community for All."
            class="w-full h-auto rounded-2xl shadow-soft border border-slate-200"
            loading="eager"
            width="1198" height="1313"
          />
        </picture>
      </div>
    </div>
  </div>
</section>
