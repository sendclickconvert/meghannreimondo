---
// Campaign hero — full-bleed photo of Meghann with headline overlay.
// Desktop: hero-desktop.png  Mobile: hero-mobile.jpg
// Redesigned to match Natane's design (Sep 2026).
import { site } from '../data/site';
---

<section class="relative overflow-hidden min-h-[80vh] lg:min-h-[90vh] flex items-end lg:items-center">

  <!-- Background photo — desktop vs mobile via <picture> -->
  <picture class="absolute inset-0 w-full h-full">
    <source media="(min-width: 768px)" srcset="/images/hero-desktop.webp" type="image/webp" />
    <source media="(min-width: 768px)" srcset="/images/hero-desktop.png" />
    <source srcset="/images/hero-mobile.webp" type="image/webp" />
    <img
      src="/images/hero-mobile.jpg"
      alt="Meghann Reimondo at a Woodstock community evening event"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      width="1672" height="941"
    />
  </picture>

  <!-- Desktop only: navy-left gradient so headline stays readable on left side -->
  <div class="absolute inset-0 hidden lg:block" style="background: linear-gradient(to right, rgba(1,37,102,0.90) 0%, rgba(1,37,102,0.65) 35%, rgba(1,37,102,0.15) 58%, transparent 78%)"></div>
  <!-- Mobile only: subtle bottom scrim so white text is readable — no heavy colour overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent lg:hidden"></div>

  <!-- Content -->
  <div class="relative z-10 container-wide pb-8 pt-0 lg:py-24 w-full">
    <!-- Mobile: centred block at bottom; Desktop: left-aligned with red accent bar -->
    <div class="max-w-xs sm:max-w-sm lg:max-w-sm mx-auto lg:mx-0 text-center lg:text-left">

      <!-- Red bar — desktop only (doesn't work centred on mobile) -->
      <div class="hidden lg:flex gap-4 items-stretch">
        <div class="w-1.5 bg-red rounded-full shrink-0"></div>
        <div>
          <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">
            Write-In Candidate for Woodstock
          </p>
          <h1 class="text-4xl sm:text-5xl lg:text-5xl font-display font-extrabold text-white leading-tight">
            Meghann Reimondo&nbsp;—
            the <span class="text-red italic">"write"</span> choice for
            Town Supervisor
          </h1>
        </div>
      </div>

      <!-- Mobile headline (no bar) -->
      <div class="lg:hidden">
        <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">
          Write-In Candidate for Woodstock
        </p>
        <h1 class="text-4xl font-display font-extrabold text-white leading-tight">
          Meghann Reimondo&nbsp;—
          the <span class="text-red italic">"write"</span> choice for
          Town Supervisor
        </h1>
      </div>

    </div>
  </div>
</section>
