---
// Campaign hero — full-bleed photo of Meghann with headline overlay.
// Desktop: hero-desktop.png  Mobile: hero-mobile.jpg
// Redesigned to match Natane's design (Sep 2026).
import { site } from '../data/site';
---

<section class="relative overflow-hidden min-h-[560px] lg:min-h-[680px] flex items-end lg:items-center">

  <!-- Background photo — desktop vs mobile via <picture> -->
  <picture class="absolute inset-0 w-full h-full">
    <source media="(min-width: 768px)" srcset="/images/hero-desktop.png" />
    <img
      src="/images/hero-mobile.jpg"
      alt="Meghann Reimondo at a Woodstock community evening event"
      class="absolute inset-0 w-full h-full object-cover object-top"
      loading="eager"
      fetchpriority="high"
      width="1672" height="941"
    />
  </picture>

  <!-- Gradient overlay: dark on left/bottom so text is readable, transparent on right -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/45 to-transparent"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent lg:hidden"></div>

  <!-- Content -->
  <div class="relative z-10 container-wide py-14 lg:py-24 w-full">
    <div class="max-w-xl lg:max-w-2xl">

      <!-- Red accent bar + eyebrow -->
      <div class="flex items-center gap-3 mb-5">
        <div class="w-1 self-stretch bg-red rounded-full shrink-0"></div>
        <p class="text-xs font-heading font-bold uppercase tracking-widest text-red">
          Write-In Candidate for Woodstock
        </p>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold text-white leading-tight text-balance">
        Meghann Reimondo —<br class="hidden sm:block" />
        the <span class="text-red italic">"write"</span> choice for<br />
        Town Supervisor
      </h1>

      <!-- Subhead -->
      <p class="mt-5 text-lg lg:text-xl text-white/80 max-w-lg leading-relaxed">
        Together we can build a stronger foundation for today and for generations to come.
      </p>

      <!-- CTAs -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/how-to-vote" class="btn-accent" title="How to write in Meghann Reimondo">How to Write Me In &rarr;</a>
        <a href="/survey" class="inline-flex items-center gap-2 font-heading font-bold text-white hover:text-red transition-colors underline underline-offset-2" title="Take the Community Survey">
          Take the Community Survey &rarr;
        </a>
      </div>

    </div>
  </div>
</section>
