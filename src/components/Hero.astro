---
// Campaign hero — full-bleed photo of Meghann with headline overlay.
// Desktop: hero-desktop.png  Mobile: hero-mobile.jpg
// Redesigned to match Natane's design (Sep 2026).
import { site } from '../data/site';
---

<section class="relative overflow-hidden min-h-[80vh] lg:min-h-[90vh] flex items-end lg:items-center">

  <!-- Background photo — desktop vs mobile via <picture> -->
  <picture class="absolute inset-0 w-full h-full">
    <source media="(min-width: 768px)" srcset="/images/hero-desktop.webp" type="image/webp" />
    <source media="(min-width: 768px)" srcset="/images/hero-desktop.png" />
    <source srcset="/images/hero-mobile.webp" type="image/webp" />
    <img
      src="/images/hero-mobile.jpg"
      alt="Meghann Reimondo at a Woodstock community evening event"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      width="1672" height="941"
    />
  </picture>

  <!-- Gradient: navy on left fading to transparent — photo shows clearly on right -->
  <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(1,37,102,0.90) 0%, rgba(1,37,102,0.65) 35%, rgba(1,37,102,0.15) 58%, transparent 78%)"></div>
  <!-- Extra bottom fade on mobile so text stays readable -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent lg:hidden"></div>

  <!-- Content -->
  <div class="relative z-10 container-wide py-14 lg:py-24 w-full">
    <div class="max-w-xs sm:max-w-sm lg:max-w-sm">

      <!-- Red bar spanning full height of eyebrow + headline -->
      <div class="flex gap-3 lg:gap-4 items-stretch">
        <div class="w-1.5 bg-red rounded-full shrink-0"></div>
        <div>
          <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">
            Write-In Candidate for Woodstock
          </p>
          <h1 class="text-4xl sm:text-5xl lg:text-5xl font-display font-extrabold text-white leading-tight">
            Meghann Reimondo&nbsp;—
            the <span class="text-red italic">"write"</span> choice for
            Town Supervisor
          </h1>
        </div>
      </div>

    </div>
  </div>
</section>
