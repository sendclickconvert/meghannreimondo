---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { webPage, breadcrumb } from '../lib/schema';

const path = '/terms';
const committee = 'Friends of Meghann Reimondo';
const email = site.contact.email;
const siteUrl = site.url;
const effectiveDate = 'September 8, 2026';

const schema = webPage({
  name: 'Terms of Use',
  description: `Terms of Use for the ${committee} campaign website.`,
  path,
  extraNodes: [breadcrumb([{ name: 'Home', path: '/' }, { name: 'Terms of Use', path }])],
});
---

<BaseLayout title="Terms of Use" description={`Terms of Use for the ${committee} campaign website.`} schema={schema}>
  <section class="bg-navy text-white">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">Legal</p>
      <h1 class="text-4xl lg:text-5xl font-display font-extrabold text-white">Terms of Use</h1>
      <p class="mt-4 text-white/60 text-sm">Effective date: {effectiveDate}</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-wide py-14 lg:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <h2 class="text-2xl font-display font-bold text-navy mt-2 mb-3">Acceptance of Terms</h2>
      <p class="text-ink leading-relaxed mb-4">
        By accessing or using this website (<a href={siteUrl} class="text-red hover:underline">{siteUrl}</a>), you agree to be bound by these Terms of Use. If you do not agree, please do not use this site. These Terms apply to all visitors, supporters, and others who access or use the site.
      </p>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">About This Website</h2>
      <p class="text-ink leading-relaxed mb-4">
        This website is operated by <strong class="font-semibold text-navy">{committee}</strong> ("the Committee") in support of Meghann Reimondo's write-in candidacy for Woodstock Town Supervisor, General Election, November 3, 2026. It is a political campaign site, not a government website.
      </p>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">Political Disclaimer</h2>
      <p class="text-ink leading-relaxed mb-4">
        Paid for by {committee}. Not authorized by any candidate or candidate's committee other than Meghann Reimondo for Town Supervisor. All political content on this site represents the views and positions of the campaign only.
      </p>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">Use of This Site</h2>
      <p class="text-ink leading-relaxed mb-3">You agree to use this site only for lawful purposes. You agree not to:</p>
      <ul class="list-disc pl-6 mb-4 space-y-2 text-ink leading-relaxed">
        <li>Use the site in any way that violates applicable federal, state, or local laws or regulations</li>
        <li>Submit false, misleading, or fraudulent information through any form on this site</li>
        <li>Attempt to gain unauthorized access to any portion of this site or its related systems</li>
        <li>Interfere with or disrupt the operation of this site</li>
        <li>Use automated tools to scrape, harvest, or collect data from this site without written permission</li>
        <li>Impersonate the campaign, the candidate, the committee, or any other person or entity</li>
      </ul>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">SMS / Text Message Communications</h2>
      <p class="text-ink leading-relaxed mb-2 font-semibold text-navy">A2P 10DLC Opt-In Terms</p>
      <p class="text-ink leading-relaxed mb-4">
        When you submit your mobile phone number and provide SMS consent through this site, you agree to receive recurring automated text messages (SMS/MMS) from <strong class="font-semibold text-navy">{committee}</strong> via A2P 10DLC registered messaging. You confirm that:
      </p>
      <ul class="list-disc pl-6 mb-4 space-y-2 text-ink leading-relaxed">
        <li>You are the wireless account holder or have the account holder's authorization for the number provided</li>
        <li>You are at least 18 years of age</li>
        <li>You consent to receive campaign-related SMS/MMS messages, which may be sent using an automatic telephone dialing system</li>
        <li>Consent is not required as a condition of any purchase or participation</li>
        <li>Message and data rates may apply</li>
      </ul>
      <p class="text-ink leading-relaxed mb-4">
        To opt out of SMS at any time, reply <strong class="font-semibold">STOP</strong>. For help, reply <strong class="font-semibold">HELP</strong> or email <a href={`mailto:${email}`} class="text-red hover:underline">{email}</a>. Mobile opt-in data will not be shared with third parties for their own marketing purposes. See our <a href="/privacy-policy" class="text-red hover:underline">Privacy Policy</a> for full SMS data practices.
      </p>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">Email Communications</h2>
      <p class="text-ink leading-relaxed mb-4">
        When you submit your contact information through this site, you consent to receive campaign communications by email. You may unsubscribe from email at any time by following the unsubscribe link in any campaign email or by emailing <a href={`mailto:${email}`} class="text-red hover:underline">{email}</a>.
      </p>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">Contributions</h2>
      <p class="text-ink leading-relaxed mb-4">
        Political contributions made through or referenced on this site are subject to New York State campaign finance law. Contributions are not tax-deductible as charitable donations.
      </p>
      <p class="text-ink leading-relaxed mb-3">By making a contribution, you confirm that:</p>
      <ul class="list-disc pl-6 mb-4 space-y-2 text-ink leading-relaxed">
        <li>You are a U.S. citizen or lawfully admitted permanent resident</li>
        <li>The contribution is made from your own funds and not on behalf of another person or entity</li>
        <li>You are not a federal contractor</li>
        <li>You are at least 18 years old</li>
      </ul>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">Intellectual Property</h2>
      <p class="text-ink leading-relaxed mb-4">
        All content on this site — including text, images, graphics, logos, and design — is owned by or licensed to the Committee and protected by applicable copyright and trademark law. You may share links to this site and share content for non-commercial, personal political expression, provided you attribute it to the campaign. Commercial use or reproduction without written permission is prohibited.
      </p>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">No Warranties</h2>
      <p class="text-ink leading-relaxed mb-4">
        This site is provided "as is" and "as available" without warranties of any kind, express or implied, including but not limited to warranties of merchantability, fitness for a particular purpose, or non-infringement. The Committee does not warrant that the site will be error-free, uninterrupted, or free of viruses or other harmful components.
      </p>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">Limitation of Liability</h2>
      <p class="text-ink leading-relaxed mb-4">
        To the fullest extent permitted by law, the Committee, its officers, agents, and volunteers shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising out of your access to or use of (or inability to use) this site, even if advised of the possibility of such damages.
      </p>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">Third-Party Links</h2>
      <p class="text-ink leading-relaxed mb-4">
        This site may contain links to third-party websites. These links are provided for convenience only. The Committee does not control, endorse, or assume responsibility for the content or privacy practices of any third-party site.
      </p>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">Governing Law</h2>
      <p class="text-ink leading-relaxed mb-4">
        These Terms are governed by the laws of the State of New York, without regard to its conflict-of-law provisions. Any dispute arising under these Terms shall be resolved in the courts of New York State.
      </p>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">Changes to These Terms</h2>
      <p class="text-ink leading-relaxed mb-4">
        We reserve the right to update or modify these Terms at any time. Changes will be posted on this page with an updated effective date. Your continued use of the site after changes are posted constitutes your acceptance of the revised Terms.
      </p>

      <hr class="border-slate-200 my-8" />

      <h2 class="text-2xl font-display font-bold text-navy mt-8 mb-3">Contact</h2>
      <p class="text-ink leading-relaxed mb-4">
        Questions about these Terms? Email us at <a href={`mailto:${email}`} class="text-red hover:underline">{email}</a>.
      </p>

      <hr class="border-slate-200 my-8" />

      <p class="text-sm text-ink/50 italic">
        Paid for by {committee}. Not authorized by any candidate or candidate's committee other than Meghann Reimondo for Town Supervisor.
      </p>

    </div>
  </section>
</BaseLayout>
