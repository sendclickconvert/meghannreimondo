---
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteInBlock from '../components/WriteInBlock.astro';
import { site } from '../data/site';
import { graph, profilePage, breadcrumb } from '../lib/schema';

const path = '/about';
const schema = graph([
  profilePage({
    name: `Meet ${site.candidate.name}`,
    description: `About ${site.candidate.name}, write-in candidate for ${site.candidate.office}.`,
    path,
  }),
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Meet Meghann', path },
  ]),
]);
---

<BaseLayout title="Meet Meghann" description={`About ${site.candidate.name}, write-in candidate for ${site.candidate.office}.`} schema={schema}>
  <section class="bg-navy text-white">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">My story</p>
      <h1 class="text-4xl lg:text-5xl font-display font-extrabold text-white">Meet {site.candidate.name}</h1>
      <p class="mt-4 text-lg text-white/70">Write-in candidate for {site.candidate.office}.</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-narrow py-14 lg:py-20">
      <div class="grid md:grid-cols-[280px,1fr] gap-10 items-start">
        <picture class="md:sticky md:top-28">
          <source srcset={`${site.media.headshot}.webp`} type="image/webp" />
          <img
            src={`${site.media.headshot}.jpg`}
            alt="Meghann Reimondo, candidate for Woodstock Town Supervisor"
            class="rounded-2xl shadow-soft w-full h-auto"
            width="900" height="1337"
            loading="eager"
          />
        </picture>
        <div class="space-y-8 text-lg text-ink/80 leading-relaxed">
          <p>
            Woodstock has been my home for nineteen years. It's where my husband Mike and I are raising our
            two children, where I've built a career, and where I've spent the last year serving inside town
            government as First Deputy Town Clerk — carrying out the full duties of that office.
          </p>
          <p>
            Before and alongside that work, I've spent more than twenty-five years in administration, human
            resources, business management, and bookkeeping. I founded a business that helps other
            organizations get organized: building budgets, setting up clear bookkeeping, and creating
            sustainable systems so they can run smoothly instead of lurching from crisis to crisis. I've also
            served on the Onteora Board of Education, because I believe the people closest to a community
            should help shape it.
          </p>
          <p>
            That combination — hands-on experience inside Town Hall, and a professional life spent building
            budgets and systems — is exactly what I'd bring to the Supervisor's office.
          </p>
          <p class="text-sm font-semibold text-red">
            [MEGHANN: add anything on education, awards, or community involvement you'd like included — and
            confirm this reads like you.]
          </p>
        </div>
      </div>

      <figure class="mt-14 max-w-2xl mx-auto">
        <picture>
          <source srcset={`${site.media.groupPhoto}.webp`} type="image/webp" />
          <img
            src={`${site.media.groupPhoto}.jpg`}
            alt="Meghann Reimondo with volunteers serving a community lunch in Woodstock"
            class="rounded-2xl shadow-soft w-full h-auto"
            width="1200" height="844"
            loading="lazy"
          />
        </picture>
        <figcaption class="mt-2 text-sm text-ink/60 text-center">Serving a community lunch with Woodstock volunteers.</figcaption>
      </figure>
    </div>
  </section>

  <WriteInBlock tone="light" />
</BaseLayout>
