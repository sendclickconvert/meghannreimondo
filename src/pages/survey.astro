---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, INTEGRATIONS } from '../data/site';
import { webPage, breadcrumb } from '../lib/schema';

const path = '/survey';
// Configurable submit target — drop the GHL webhook URL into INTEGRATIONS.surveyEndpoint
// (site.ts) to POST direct; otherwise falls back to the built-in /api/submit-form route.
const surveyEndpoint = INTEGRATIONS.surveyEndpoint || '/api/submit-form';

const schema = webPage({
  name: 'Community Survey',
  description: `Share what matters most to you about Woodstock's future with ${site.candidate.name}'s campaign.`,
  path,
  extraNodes: [breadcrumb([{ name: 'Home', path: '/' }, { name: 'Community Survey', path }])],
});

const fieldCls =
  'w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-navy focus:border-navy';
const labelCls = 'block text-sm font-heading font-semibold text-navy mb-1';

const priorityOptions = [
  'Fiscal Responsibility', 'Staffing', 'Infrastructure', 'Water Quality', 'Housing',
  'Roads', 'Public Safety', 'Economic Development', 'Environmental Protection', 'Other',
];
---

<BaseLayout
  title="Community Survey"
  description={`Share what matters most to you about Woodstock's future with ${site.candidate.name}'s campaign.`}
  schema={schema}
>
  <section class="bg-navy text-white">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">Your voice</p>
      <h1 class="text-4xl lg:text-5xl font-display font-extrabold text-white">Help Shape Woodstock's Future</h1>
      <p class="mt-4 text-lg text-white/70 max-w-2xl mx-auto">
        This campaign isn't about assuming we know every answer. It's about listening. Before decisions are
        made, I want to understand what matters most to the people who call Woodstock home. Your voice will
        help guide this campaign and, if elected, my priorities in office.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-narrow py-14 lg:py-20 max-w-2xl">
      <div class="card" id="survey-form-wrap">
        <form id="survey-form" class="space-y-6" novalidate data-endpoint={surveyEndpoint}>
          <div>
            <label class={labelCls} for="q1">
              What are the three most important issues facing Woodstock today? <span class="text-red">*</span>
            </label>
            <textarea class={fieldCls} id="q1" name="topIssues" rows="3" required></textarea>
          </div>

          <div>
            <label class={labelCls} for="q2">
              Which deserves the most immediate attention? <span class="text-red">*</span>
            </label>
            <select class={fieldCls} id="q2" name="topPriority" required>
              <option value="" disabled selected>Select one…</option>
              {priorityOptions.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </div>

          <div>
            <label class={labelCls} for="q3">What do you love most about Woodstock? <span class="text-red">*</span></label>
            <textarea class={fieldCls} id="q3" name="loveMost" rows="3" required></textarea>
          </div>

          <div>
            <label class={labelCls} for="q4">What concerns you most about Woodstock's future? <span class="text-red">*</span></label>
            <textarea class={fieldCls} id="q4" name="concernMost" rows="3" required></textarea>
          </div>

          <div>
            <label class={labelCls} for="q5">
              If you could improve one thing over the next four years, what would it be? <span class="text-red">*</span>
            </label>
            <textarea class={fieldCls} id="q5" name="improveOne" rows="3" required></textarea>
          </div>

          <div>
            <label class={labelCls} for="q6">Is there something Town government could do better? <span class="text-red">*</span></label>
            <textarea class={fieldCls} id="q6" name="govBetter" rows="3" required></textarea>
          </div>

          <!-- Q7 — entirely optional. The survey can be submitted anonymously. -->
          <fieldset class="border-t border-slate-200 pt-5">
            <legend class="text-sm font-heading font-semibold text-navy">
              Optional — stay updated <span class="text-ink/40 font-normal">(you can submit anonymously)</span>
            </legend>
            <div class="grid sm:grid-cols-2 gap-4 mt-3">
              <div>
                <label class={labelCls} for="name">Name <span class="text-ink/40 font-normal">(optional)</span></label>
                <input class={fieldCls} id="name" name="name" type="text" autocomplete="name" />
              </div>
              <div>
                <label class={labelCls} for="email">Email <span class="text-ink/40 font-normal">(optional)</span></label>
                <input class={fieldCls} id="email" name="email" type="email" autocomplete="email" />
              </div>
            </div>
            <label class="flex items-start gap-3 cursor-pointer mt-4">
              <input class="mt-1 h-4 w-4 shrink-0 accent-red" id="updates" name="updatesConsent" type="checkbox" />
              <span class="text-sm text-ink/70">
                Yes, I'd like to receive updates from Friends of Meghann Reimondo.
              </span>
            </label>
          </fieldset>

          <p id="survey-error" class="text-sm font-semibold text-red hidden" role="alert" aria-live="assertive"></p>

          <button type="submit" class="btn-accent w-full" id="survey-submit">Submit Survey</button>
        </form>
      </div>

      <!-- Thank-you state -->
      <div class="card text-center hidden" id="survey-success" role="status" aria-live="polite" tabindex="-1">
        <span class="section-divider mx-auto mb-4"></span>
        <h2 class="text-2xl font-display font-extrabold text-navy">Thank you.</h2>
        <p class="mt-3 text-ink/70 max-w-xl mx-auto">
          Thank you for taking the time to share your thoughts. Whether or not we agree on every issue, every
          response helps me better understand our community. Listening is where good leadership begins.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('survey-form');
  const wrap = document.getElementById('survey-form-wrap');
  const success = document.getElementById('survey-success');
  const errEl = document.getElementById('survey-error');
  const submitBtn = document.getElementById('survey-submit');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl.classList.add('hidden');

    // Required survey questions (1–6) enforced natively; Q7 fields are all optional.
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());
    // Submitting is NOT an email opt-in — consent is the checkbox alone.
    payload.updatesConsent = form.querySelector('#updates').checked;
    payload.source = 'community-survey';

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    try {
      const res = await fetch(form.dataset.endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('bad status');
      wrap.classList.add('hidden');
      success.classList.remove('hidden');
      success.focus();
    } catch {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Survey';
      errEl.textContent = 'Something went wrong. Please try again.';
      errEl.classList.remove('hidden');
    }
  });
</script>
