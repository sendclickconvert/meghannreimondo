---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WriteInBlock from '../components/WriteInBlock.astro';
import { site } from '../data/site';
import { homeGraph } from '../lib/schema';

const schema = homeGraph();

// Three-up teasers to key pages (per staged copy v1).
const links = [
  { label: "Why I'm Running", href: '/issues', desc: 'Accessible, transparent leadership that listens first.', cta: 'See where I stand →' },
  { label: 'How to Write Me In', href: '/how-to-vote', desc: "My name won't be on the ballot. Here's exactly how to make your vote count.", cta: 'Show me →' },
  { label: 'Get Involved', href: '/volunteer', desc: 'Volunteer, contribute, or bring a friend. This is won neighbor by neighbor.', cta: 'Join us →' },
];
---

<BaseLayout
  title="Home"
  description={`${site.candidate.name} is a write-in candidate for ${site.candidate.office}. Learn how to write in her name so your vote counts.`}
  schema={schema}
>
  <Hero />

  <!-- Primary write-in teaching block (the site's #1 job) -->
  <WriteInBlock tone="navy" />

  <!-- Short intro -->
  <section class="bg-white">
    <div class="container-narrow py-14 lg:py-20">
      <div class="section-divider mb-5"></div>
      <p class="text-lg lg:text-xl text-ink/80 leading-relaxed max-w-3xl">
        For nineteen years, Woodstock has been my home — where my husband Mike and I are raising our two
        children, and where I've built a career, served on the school board, and worked every day inside
        town government. I know how this town runs, and I know it can run with more openness, more
        collaboration, and more heart.
      </p>
      <a href="/about" class="inline-block mt-5 font-heading font-bold text-navy hover:text-red transition-colors underline" title="Meet Meghann">Read my story &rarr;</a>
    </div>
  </section>

  <!-- Three-up teasers -->
  <section class="bg-cream">
    <div class="container-wide py-14 lg:py-20">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {links.map((l) => (
          <a href={l.href} class="card group" title={l.label}>
            <h3 class="font-display font-bold text-lg text-navy group-hover:text-red transition-colors">{l.label}</h3>
            <p class="mt-2 text-sm text-ink/70">{l.desc}</p>
            <p class="mt-3 text-sm font-heading font-bold text-red">{l.cta}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
