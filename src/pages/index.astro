---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WriteInBlock from '../components/WriteInBlock.astro';
import { site } from '../data/site';
import { homeGraph } from '../lib/schema';

const schema = homeGraph();

// Three questions — her structure (content pack v2).
const questions = [
  { q: 'Who is Meghann?', a: "A neighbor who's already serving Woodstock — and who understands how local government actually works.", href: '/about', cta: 'Meet Meghann →' },
  { q: 'Why is she running?', a: 'Because Woodstock deserves leadership that listens, plans responsibly, supports its employees, and prepares the town for the future.', href: '/issues', cta: 'See her priorities →' },
  { q: 'How can I help?', a: 'Volunteer, contribute, endorse, take the community survey — or just learn more.', href: '/volunteer', cta: 'Get involved →' },
];

---

<BaseLayout
  title="Home"
  description={`${site.candidate.name} is a write-in candidate for ${site.candidate.office}. Learn how to write in her name so your vote counts.`}
  schema={schema}
>
  <Hero />

  <!-- Primary write-in teaching block (the site's #1 job) -->
  <WriteInBlock tone="navy" />

  <!-- Three questions (her structure) -->
  <section class="bg-white">
    <div class="container-wide py-14 lg:py-20">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {questions.map((l) => (
          <a href={l.href} class="card group" title={l.q}>
            <h3 class="font-display font-bold text-lg text-navy group-hover:text-red transition-colors">{l.q}</h3>
            <p class="mt-2 text-sm text-ink/70">{l.a}</p>
            <p class="mt-3 text-sm font-heading font-bold text-red">{l.cta}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The Foundation -->
  <section class="bg-cream">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <div class="section-divider mx-auto mb-5"></div>
      <h2 class="text-3xl lg:text-4xl font-display font-extrabold text-navy text-balance">A strong community begins with a strong foundation.</h2>
      <p class="mt-4 text-lg text-ink/75 max-w-2xl mx-auto">
        This campaign doesn't begin with a list of promises. It begins with a commitment to building a
        strong foundation — because everything else grows from there.
      </p>
      <!-- Foundation graphic: client-provided pyramid infographic (native 1198px wide — never upscaled past that) -->
      <div class="mt-10 mx-auto w-full max-w-[1198px]">
        <picture>
          <source srcset="/images/foundation-pyramid.webp" type="image/webp" />
          <img
            src="/images/foundation-pyramid.png"
            alt="Pyramid diagram titled 'A Strong Foundation Builds Everything That Matters.' From the base up: Our Infrastructure — the foundation (roads, buildings, staff, systems and equipment, culture); Our People and Culture — support for dedicated staff and a respectful work culture; Open Door Leadership — accessible, listening leadership; Opportunity and Growth — responsible economic development, local businesses, recreation, and the arts; and at the top, Thriving Community — a safe, vibrant, connected community where everyone can live, work, and belong. Tagline: Strong Foundations. Smart Decisions. A Better Community for All."
            class="w-full h-auto rounded-2xl shadow-soft"
            loading="lazy"
            width="1198" height="1313"
          />
        </picture>
      </div>
      <a href="/issues" class="btn-primary mt-8 inline-block" title="Five Core Priorities">Explore the Five Priorities &rarr;</a>
    </div>
  </section>

  <!-- Community band — service photo -->
  <section class="bg-white">
    <div class="container-wide py-14 lg:py-20">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <picture>
          <source srcset={`${site.media.communityPhoto}.webp`} type="image/webp" />
          <img
            src={`${site.media.communityPhoto}.jpg`}
            alt="Meghann Reimondo with volunteers at a Woodstock community cleanup day"
            class="rounded-2xl shadow-soft w-full h-auto"
            loading="lazy"
            width="1600" height="1200"
          />
        </picture>
        <div>
          <div class="section-divider mb-5"></div>
          <h2 class="text-3xl lg:text-4xl font-display font-extrabold text-navy text-balance">Already showing up for Woodstock</h2>
          <p class="mt-4 text-lg text-ink/75">
            For nineteen years, Woodstock has been my home — where my husband Mike and I are raising our
            two children, and where I've built a career, served on the school board, and worked every day
            inside town government. This isn't a campaign against anyone. We're running <em>for</em> Woodstock.
          </p>
          <a href="/about" class="inline-block mt-5 font-heading font-bold text-navy hover:text-red transition-colors underline" title="Meet Meghann">Read my story &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Survey invitation -->
  <section class="bg-navy text-white">
    <div class="container-narrow py-14 lg:py-16 text-center">
      <h2 class="text-2xl lg:text-3xl font-display font-extrabold text-balance">This campaign starts by listening.</h2>
      <p class="mt-3 text-white/70 max-w-xl mx-auto">Tell me what matters most to you — the Community Survey takes just a few minutes, and you can respond anonymously.</p>
      <a href="/survey" class="btn-accent mt-6 inline-block" title="Take the Community Survey">Take the Community Survey &rarr;</a>
    </div>
  </section>
</BaseLayout>
