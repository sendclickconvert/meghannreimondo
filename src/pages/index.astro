---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
import { homeGraph } from '../lib/schema';

const schema = homeGraph();

const pillars = ['Fiscal Responsibility', 'Supporting Our Staff', 'Communication & Transparency', 'Infrastructure', 'Water'];
---

<BaseLayout
  title="Home"
  description={`${site.candidate.name} is a write-in candidate for ${site.candidate.office}. Learn how to write in her name so your vote counts.`}
  schema={schema}
>

  <!-- 1. Hero — full-bleed photo -->
  <Hero />

  <!-- 2. Together section -->
  <section class="bg-white">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <p class="text-xl lg:text-2xl font-display font-bold text-navy max-w-2xl mx-auto leading-snug">
        Together we can build a stronger foundation for today and for generations. You Love Woodstock. So Do I.
      </p>
      <a href="/about" class="btn-accent mt-8 inline-block" title="Meet Meghann">Meet Meghann</a>
    </div>
  </section>

  <!-- 3. Write-in call to action (navy) -->
  <section class="bg-navy text-white">
    <div class="container-narrow py-14 lg:py-16 text-center">
      <p class="text-lg lg:text-xl text-white/90 leading-relaxed">
        This November, my name won't be printed on the ballot. You'll need to write it in.
      </p>
      <p class="mt-3 text-lg lg:text-xl text-white/90 leading-relaxed">
        This is a grassroots movement—each and every one of you matters.
      </p>
      <p class="mt-3 text-lg lg:text-xl text-white/90 leading-relaxed">
        Please take action and vote the right choice on November 3rd.
      </p>
      <a href="/how-to-vote" class="btn-accent mt-8 inline-block" title="How to write in Meghann Reimondo">Write me in</a>
    </div>
  </section>

  <!-- 4. Full-width photo — Meghann at a house party -->
  <div class="relative overflow-hidden" style="height: clamp(480px, 56vw, 680px);">
    <picture class="absolute inset-0 w-full h-full">
      <source media="(min-width: 768px)" srcset="/images/meghann-desk-desktop.webp" type="image/webp" />
      <source media="(min-width: 768px)" srcset="/images/meghann-desk-desktop.png" />
      <source srcset="/images/meghann-desk-mobile.webp" type="image/webp" />
      <img
        src="/images/meghann-desk-mobile.png"
        alt="Meghann Reimondo speaking with supporters at a Woodstock house party"
        class="absolute inset-0 w-full h-full object-cover object-top"
        loading="lazy"
      />
    </picture>
  </div>

  <!-- 5. Foundation section -->
  <section class="bg-slate-100">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <h2 class="text-3xl lg:text-5xl font-display font-extrabold text-navy leading-tight text-balance">
        A strong community begins<br class="hidden sm:block" /> with a strong foundation.
      </h2>
      <p class="mt-5 text-base lg:text-lg text-ink/70 max-w-xl mx-auto">
        This campaign doesn't begin with a list of promises. It begins with a commitment to building a strong foundation — because everything else grows from there.
      </p>

      <!-- Five pillars — 2-col on mobile, single row on sm+ -->
      <div class="mt-10 max-w-3xl mx-auto">
        <div class="grid grid-cols-2 sm:grid-cols-5 rounded-t-lg overflow-hidden border border-navy/20 gap-px bg-navy/20">
          {pillars.map((p, i) => (
            <div class={`bg-navy text-white text-center text-xs sm:text-sm font-heading font-bold py-6 px-2 leading-snug flex items-center justify-center min-h-[5rem]${i === 4 ? ' col-span-2 sm:col-span-1' : ''}`}>
              {p}
            </div>
          ))}
        </div>
        <div class="h-3 bg-red rounded-b-sm"></div>
        <p class="mt-3 text-xs font-heading font-semibold uppercase tracking-widest text-ink/50">The Foundation</p>
      </div>

      <a
        href="/issues"
        title="Five Core Priorities"
        class="mt-8 inline-block px-6 py-3 font-heading font-bold text-sm text-white bg-navy border-2 border-navy rounded-lg hover:bg-navy/80 transition-colors"
      >
        Explore the 5 Priorities &rarr;
      </a>
    </div>
  </section>

  <!-- 6. Bio + pyramid two-column -->
  <section class="bg-slate-100 border-t border-slate-200">
    <div class="container-wide py-14 lg:py-20">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- Foundation pyramid — first on mobile, right column on desktop -->
        <div class="order-1 lg:order-2">
          <picture>
            <source srcset="/images/foundation-pyramid.webp" type="image/webp" />
            <img
              src="/images/foundation-pyramid.png"
              alt="A Strong Foundation pyramid — five levels from infrastructure at the base to thriving community at the top"
              class="w-full h-auto rounded-xl shadow-soft"
              loading="lazy"
              width="1198" height="1313"
            />
          </picture>
        </div>
        <!-- Bio text — below pyramid on mobile, left column on desktop -->
        <div class="order-2 lg:order-1 text-ink/80 leading-relaxed space-y-5 text-base lg:text-lg text-center lg:text-left">
          <p>
            Community work has always been a part of my journey. Whether through my work, my volunteering, or the business I ran for eleven years, caring for the people around me has always been at the core of who I am.
          </p>
          <p>
            That combination — hands-on experience inside the Comeau, and a professional life spent building budgets and systems — is exactly what I'd bring to the Supervisor's office.
          </p>
          <p class="font-display font-bold text-red text-xl italic">Meghann Reimondo</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Your voice — three columns (navy) -->
  <section class="bg-navy text-white">
    <div class="container-wide py-14 lg:py-20">
      <div class="grid sm:grid-cols-3 gap-8 text-center">
        <div>
          <p class="text-2xl lg:text-3xl font-display font-extrabold text-white">Your voice matters.</p>
        </div>
        <div>
          <p class="text-2xl lg:text-3xl font-display font-extrabold text-white">Your voice counts.</p>
        </div>
        <div>
          <p class="text-2xl lg:text-3xl font-display font-extrabold text-white">Your voice is heard.</p>
        </div>
      </div>
      <div class="mt-10 text-center">
        <a href="/how-to-vote" class="btn-accent inline-block" title="How to write in Meghann Reimondo">How to Write Me In</a>
      </div>
    </div>
  </section>

  <!-- 8. We the people — 4:3 on mobile, natural landscape proportions on desktop -->
  <div id="wtp-section" class="relative overflow-hidden flex items-center justify-center">
    <picture class="absolute inset-0 w-full h-full">
      <source srcset="/images/people-desktop.webp" type="image/webp" />
      <img
        src="/images/people-mobile.jpg"
        alt="Woodstock community members — We the people"
        class="absolute inset-0 w-full h-full object-cover object-right-top"
        loading="lazy"
        width="1672" height="941"
      />
    </picture>
    <!-- Gradient: left+bottom navy/purple tint, transparent in center — matches Lovable -->
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(1,37,102,0.65) 0%, rgba(80,40,160,0.25) 40%, rgba(1,37,102,0.55) 100%)"></div>
    <!-- Text -->
    <div class="relative z-10 text-center px-6">
      <h2 class="text-4xl lg:text-6xl font-display font-extrabold text-white" style="text-shadow: 0 2px 12px rgba(0,0,0,0.55);">We the people</h2>
      <p class="mt-3 text-lg lg:text-2xl font-display font-semibold text-white" style="text-shadow: 0 1px 8px rgba(0,0,0,0.45);">Returning Woodstock to its grassroots</p>
    </div>
    <!-- Bottom caption -->
    <p class="absolute bottom-5 inset-x-0 text-center text-xs font-heading text-white/70">
      Write in Meghann Reimondo for Town Supervisor &middot; November 3, 2026
    </p>
  </div>

</BaseLayout>

<style>
  /* "We the people" — 4:3 on mobile, natural landscape height on desktop */
  #wtp-section {
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 1024px) {
    #wtp-section {
      aspect-ratio: auto;
      min-height: clamp(560px, 56.3vw, 1000px);
    }
  }
</style>
