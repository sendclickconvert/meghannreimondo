---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
import { homeGraph } from '../lib/schema';

const schema = homeGraph();

// Quick links to the core pages (funnels toward the write-in teaching job).
const links = [
  { label: 'How to Write In', href: '/how-to-vote', desc: 'Step-by-step: write in her name so your vote counts.' },
  { label: 'Meet Meghann', href: '/about', desc: 'Who she is and why she is running.' },
  { label: 'Issues', href: '/issues', desc: 'Where she stands, in her own words.' },
  { label: 'Endorsements', href: '/endorsements', desc: 'Who is backing the campaign.' },
  { label: 'Events', href: '/events', desc: 'Meet the campaign in person.' },
  { label: 'Volunteer', href: '/join', desc: 'Lend a hand between now and Election Day.' },
  { label: 'Contribute', href: '/contribute', desc: 'Chip in to power the campaign.' },
  { label: 'Contact', href: '/contact', desc: 'Get in touch or join the list.' },
];
---

<BaseLayout
  title="Home"
  description={`${site.candidate.name} is a write-in candidate for ${site.candidate.office}. Learn how to write in her name so your vote counts.`}
  schema={schema}
>
  <Hero />

  <!-- Page directory -->
  <section class="bg-white">
    <div class="container-wide py-14 lg:py-20">
      <div class="max-w-2xl mb-10">
        <div class="section-divider mb-5"></div>
        <h2 class="text-3xl lg:text-4xl font-display font-extrabold text-navy">The campaign at a glance</h2>
        <p class="mt-3 text-ink/70">
          Everything you need to support {site.candidate.name}'s write-in campaign for {site.candidate.office}.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {links.map((l) => (
          <a href={l.href} class="card group" title={l.label}>
            <h3 class="font-display font-bold text-lg text-navy group-hover:text-red transition-colors">{l.label}</h3>
            <p class="mt-2 text-sm text-ink/70">{l.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
