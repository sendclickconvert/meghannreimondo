---
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteInBlock from '../components/WriteInBlock.astro';
import { site } from '../data/site';
import { webPage, breadcrumb } from '../lib/schema'; // graph/eventNode re-added when event address+time are confirmed

const path = '/events';

// Real events only. Each entry becomes an Event node (organizer = committee Org).
const events: {
  name: string; startDate: string; endDate?: string;
  time?: string;            // human-readable time string for display
  locationName: string; address?: string; url?: string;
  details?: string;         // brief description shown on the card
}[] = [
  {
    name: 'Volunteering at Volunteers Day',
    startDate: '2026-08-15',
    locationName: 'Volunteers Day',
    url: 'https://www.volunteersday.org/',
  },
  {
    name: 'Stellarmuse table at Woodstock Awakening',
    startDate: '2026-08-16',
    locationName: 'Woodstock Awakening',
    url: 'https://woodstockawakening.org/',
  },
  {
    name: 'Meet & Greet with Meghann',
    startDate: '2026-09-19',
    endDate: '2026-09-19',
    time: '4:00 – 6:30 pm',
    locationName: '27 Schoonmaker Lane',
    address: '27 Schoonmaker Lane, Woodstock, NY 12498',
    details: 'Appetizers, beer, and wine. Come meet Meghann and hear about her vision for Woodstock.',
  },
];

const fmtDate = (d: string) =>
  new Date(d + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

const bc = breadcrumb([
  { name: 'Home', path: '/' },
  { name: 'Events', path },
]);

// NOTE: Event JSON-LD is intentionally NOT emitted for now — the listed events have no
// confirmed venue address or start/end time yet, and incomplete Event markup is worse
// than none. Re-enable `graph([...events.map(eventNode)])` once address + time are confirmed.
const schema = webPage({
  name: 'Events',
  description: `Campaign events for ${site.candidate.name}.`,
  path,
  extraNodes: [bc],
});
---

<BaseLayout title="Events" description={`Campaign events for ${site.candidate.name}.`} schema={schema}>
  <section class="bg-navy text-white">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">Meet the campaign</p>
      <h1 class="text-4xl lg:text-5xl font-display font-extrabold text-white">Events</h1>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-narrow py-14 lg:py-20">
      {events.length === 0 ? (
        <div class="card border-dashed border-2 border-red/40 text-center">
          <p class="font-display font-bold text-lg text-navy">[TODO — no events posted]</p>
          <p class="mt-2 text-ink/70">Upcoming campaign events will appear here once scheduled. No events are listed until they are real.</p>
        </div>
      ) : (
        <div class="grid sm:grid-cols-2 gap-5">
          {events.map((e) => (
            <div class="card">
              <p class="text-xs font-heading font-bold uppercase tracking-widest text-red">{fmtDate(e.startDate)}{e.time && <span class="normal-case tracking-normal"> · {e.time}</span>}</p>
              <h3 class="mt-2 font-display font-bold text-lg text-navy">{e.name}</h3>
              <p class="mt-1 text-sm text-ink/70">{e.address ?? e.locationName}</p>
              {e.details && <p class="mt-2 text-sm text-ink/75">{e.details}</p>}
              {e.url && (
                <a href={e.url} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block font-heading font-bold text-sm text-navy hover:text-red underline transition-colors">
                  Event details &rarr;
                </a>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <WriteInBlock tone="light" />
</BaseLayout>
