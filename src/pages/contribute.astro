---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, isTodo } from '../data/site';
import { webPage, breadcrumb } from '../lib/schema';

const path = '/contribute';
const schema = webPage({
  name: 'Contribute',
  description: `Contribute to ${site.candidate.name}'s write-in campaign for ${site.candidate.office}.`,
  path,
  extraNodes: [breadcrumb([{ name: 'Home', path: '/' }, { name: 'Contribute', path }])],
});

const email = isTodo(site.contact.email) ? null : site.contact.email;
---

<BaseLayout title="Contribute" description={`Contribute to ${site.candidate.name}'s campaign.`} schema={schema}>
  <section class="bg-navy text-white">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">Power the campaign</p>
      <h1 class="text-4xl lg:text-5xl font-display font-extrabold text-white">Contribute</h1>
      <p class="mt-4 text-lg text-white/80 max-w-2xl mx-auto">
        Chip in to help Meghann reach every Woodstock voter before November 3.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-narrow py-14 lg:py-20 max-w-xl">
      <div class="card text-center">
        <p class="font-display font-bold text-2xl text-navy mb-3">Online giving is coming soon</p>
        <p class="text-ink/75 mb-6">
          We're finishing the paperwork so we can accept contributions the right way. In the meantime, if you'd like to contribute, please reach out and we'll help you.
        </p>
        {email ? (
          <a href={`mailto:${email}`} class="btn-accent" title="Contact us to contribute">Contact us to contribute</a>
        ) : (
          <a href="/contact" class="btn-accent" title="Contact us to contribute">Contact us to contribute</a>
        )}

        <!-- Compliance note: live donations are intentionally NOT wired. Blocked on NY BOE committee registration. -->
        <p class="mt-8 text-sm text-ink/60 border-l-4 border-red pl-3 text-left">
          Live online giving is pending committee registration. New York campaign-finance rules require the registered committee name and specific contribution disclaimers before we can accept donations online, so we've held off until that's confirmed.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
