---
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteInBlock from '../components/WriteInBlock.astro';
import { site } from '../data/site';
import { graph, howTo, faqPage, breadcrumb } from '../lib/schema';

const path = '/how-to-vote';

// ---- HowTo steps: generic NY paper / optical-scan write-in mechanics (factual, non-promotional) ----
const steps = [
  {
    name: 'Find the race for Town Supervisor',
    text: `On your ballot, find the race for ${site.candidate.office}.`,
  },
  {
    name: 'Find the write-in area at the bottom of the ballot, in the Town Supervisor column',
    text: 'At the bottom of the ballot, look for the Town Supervisor column. The write-in line is at the bottom of that column — it is the blank line reserved for candidates whose names are not printed.',
  },
  {
    name: 'Write in: MEGHANN REIMONDO',
    text: 'On that write-in line, write Meghann Reimondo as clearly as you can. It does not have to be spelled perfectly. Election officials count a write-in when it\'s clear who the voter meant, so do your best and your vote counts.',
  },
  {
    name: 'Fill it in to make your vote count',
    text: 'Fill in the mark next to the write-in line so the scanner registers your vote.',
  },
  {
    name: 'Finish and submit your ballot',
    text: 'Finish the rest of your ballot and submit it as usual.',
  },
];

// ---- FAQ: answers are VERBATIM-matched to the schema (same strings rendered on-page) ----
const faqs = [
  {
    q: "Is Meghann Reimondo's name printed on the ballot?",
    a: 'No. Meghann is a write-in candidate, so her name is not pre-printed on the ballot. To vote for her, you add her name yourself in the write-in area for the Town Supervisor race.',
  },
  {
    q: 'How do I spell her name correctly?',
    a: 'Meghann Reimondo — "Meghann" with a double n (M-E-G-H-A-N-N) and "Reimondo" (R-E-I-M-O-N-D-O). But you do not have to get it letter-perfect. Meghann confirmed with the Ulster County Board of Elections that a close spelling still counts, as long as it\'s clear you meant her. Write it as clearly as you can and don\'t worry about it.',
  },
  {
    q: 'Do I have to fill in the rectangle too?',
    a: "On New York's optical-scan ballots you must both write the name on the write-in line and fill in the rectangle next to the write-in line so the scanner registers it.",
  },
  {
    q: 'Where is the write-in line on the ballot?',
    a: 'At the bottom of the ballot, in the Town Supervisor column. The write-in line sits below the printed candidates for that office.',
  },
  {
    q: 'Does my handwriting need to be perfect?',
    a: 'No. Print it if that\'s easier to read. What matters is that an election official can tell who you meant — not perfect handwriting or perfect spelling.',
  },
  {
    q: 'What if I spell her name wrong?',
    a: 'Your vote still counts. A write-in is counted when the voter\'s intent is clear, so a small misspelling will not throw it out. Get as close as you can — that\'s all that\'s needed.',
  },
  {
    q: 'Can I write her in on an early, absentee, or mail ballot?',
    a: 'Write-in rules apply the same way on early, absentee, and mail ballots — you write her name in the Town Supervisor write-in area and complete the mark.',
  },
];

const schema = graph([
  howTo({
    name: `How to write in ${site.candidate.name} for ${site.candidate.office}`,
    description: `Step-by-step instructions for casting a valid write-in vote for ${site.candidate.name} in the ${site.candidate.office} race.`,
    path,
    steps,
  }),
  faqPage(faqs),
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'How to Write In', path },
  ]),
]);
---

<BaseLayout
  title="How to Write In Meghann Reimondo"
  description={`How to cast a valid write-in vote for ${site.candidate.name} for ${site.candidate.office} — write her name and complete the mark.`}
  schema={schema}
>
  <!-- Page header -->
  <section class="bg-navy text-white">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">Make your vote count</p>
      <h1 class="text-4xl lg:text-5xl font-display font-extrabold text-white text-balance">
        How to write in Meghann Reimondo
      </h1>
      <p class="mt-4 text-lg text-white/70 max-w-2xl mx-auto">
        My name will not be printed on the ballot this November. That means voting for me takes one extra
        step — and it's easy once you know how. Here's exactly what to do.
      </p>
    </div>
  </section>

  <!-- Correct-spelling callout (unmissable) -->
  <section class="bg-cream">
    <div class="container-narrow py-10 text-center">
      <p class="text-sm font-heading font-bold uppercase tracking-widest text-red mb-2">How to spell it</p>
      <p class="font-display font-extrabold text-3xl lg:text-4xl text-navy tracking-tight">Meghann Reimondo</p>
      <p class="mt-3 text-ink/70">
        <strong class="text-navy">M-E-G-H-A-N-N</strong> — double n — <strong class="text-navy">R-E-I-M-O-N-D-O</strong>
      </p>
      <p class="mt-3 inline-block bg-red text-white font-heading font-bold text-sm px-4 py-2 rounded-lg">Close is good enough. It does not have to be perfect — what matters is that it's clear you meant Meghann.</p>
    </div>
  </section>

  <!-- HowTo steps -->
  <section class="bg-white border-b border-slate-200">
    <div class="container-narrow py-8 text-center">
      <h2 class="font-display font-bold text-xl text-navy">Need a ride to the polls?</h2>
      <p class="mt-2 text-ink/75">Woodstock Vote Express is open to every voter, regardless of who you vote for. No political expectations or strings attached.</p>
      <a href="/vote-express" class="btn-accent mt-4 inline-block">Request a ride</a>
    </div>
  </section>
  <section class="bg-white">
    <div class="container-narrow py-14 lg:py-20">
      <h2 class="text-2xl lg:text-3xl font-display font-extrabold text-navy mb-8">The steps</h2>
      <ol class="space-y-6">
        {steps.map((step, i) => (
          <li class="flex gap-5">
            <span class="shrink-0 w-11 h-11 rounded-full bg-navy text-white font-display font-extrabold text-lg flex items-center justify-center">{i + 1}</span>
            <div>
              <h3 class="font-display font-bold text-lg text-navy">{step.name}</h3>
              <p class="mt-1 text-ink/75">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <!-- Official sample ballot -->
      <figure class="mt-10">
        <p class="mb-3 text-sm font-heading font-bold text-navy uppercase tracking-widest">Official Sample Ballot — 2026 General Election</p>
        <!-- Scrollable wrapper so the wide ballot doesn't break the layout on mobile -->
        <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-soft">
          <picture>
            <source srcset="/images/sample-ballot.webp" type="image/webp" />
            <img
              src="/images/sample-ballot.png"
              alt="Official 2026 General Election sample ballot for Ulster County — the Town Supervisor write-in line is in the Supervisor column near the right side of the ballot."
              class="w-full h-auto block"
              style="min-width: 640px;"
              loading="lazy"
              width="3318"
              height="1282"
            />
          </picture>
        </div>
        <figcaption class="mt-3 text-sm text-ink/60 italic leading-snug">
          Official Ulster County 2026 General Election sample ballot. Find the <strong class="text-navy not-italic">Supervisor</strong> column near the right side — the write-in line is at the very bottom of that column.
        </figcaption>
      </figure>

      <!-- Annotated close-up of the Supervisor write-in column -->
      <div class="mt-8 p-5 bg-cream rounded-xl border border-slate-200">
        <p class="text-sm font-heading font-bold text-navy uppercase tracking-widest mb-1">Supervisor column — close-up</p>
        <p class="text-sm text-ink/70 mb-4">
          The <strong class="text-navy">Supervisor</strong> column is near the right side of the ballot.
          <span class="inline-flex items-center gap-1 ml-1"><span class="inline-flex w-5 h-5 rounded-full bg-red text-white text-xs font-bold items-center justify-center">1</span> Fill in the rectangle.</span>
          <span class="inline-flex items-center gap-1 ml-1"><span class="inline-flex w-5 h-5 rounded-full bg-red text-white text-xs font-bold items-center justify-center">2</span> Write <strong class="text-navy">MEGHANN REIMONDO</strong> in the blank space below it.</span>
        </p>
        <div class="overflow-x-auto rounded-lg border border-slate-200 shadow-soft">
          <picture>
            <source srcset="/images/ballot-supervisor-zoom.webp" type="image/webp" />
            <img
              src="/images/ballot-supervisor-zoom.png"
              alt="Close-up of the Supervisor column on the ballot: ① fill in the rectangle, ② write Meghann Reimondo in the blank space below."
              class="w-full h-auto block"
              style="max-width: 640px;"
              loading="lazy"
              width="960"
              height="1148"
            />
          </picture>
        </div>
      </div>

      <div class="mt-8 card bg-cream border-0">
        <h3 class="font-display font-bold text-lg text-navy">Take it with you</h3>
        <p class="mt-1 text-ink/75">
          <a href="/meghann-wallet-card.png" download="Meghann-Reimondo-Wallet-Card.png" class="font-bold text-navy underline hover:text-red transition-colors">Download the wallet card</a> with the spelling and steps, and bring it to the polls.
        </p>
        <a
          href="/meghann-wallet-card.png"
          download="Meghann-Reimondo-Wallet-Card.png"
          class="mt-4 block group"
          title="Download the Meghann Reimondo wallet card"
        >
          <img
            src="/meghann-wallet-card.png"
            alt="Meghann Reimondo printable wallet card — front and back"
            class="rounded-lg shadow-soft border border-slate-200 w-full h-auto group-hover:opacity-90 transition-opacity"
            loading="lazy"
            width="2450"
            height="775"
          />
          <p class="mt-2 text-xs text-ink/50 text-center">Click to download</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ (static expanded HTML, verbatim-matched to FAQPage schema) -->
  <section class="bg-cream">
    <div class="container-narrow py-14 lg:py-20">
      <h2 class="text-2xl lg:text-3xl font-display font-extrabold text-navy mb-8">Write-in questions, answered</h2>
      <div class="space-y-6">
        {faqs.map((f) => (
          <div class="card">
            <h3 class="font-display font-bold text-lg text-navy">{f.q}</h3>
            <p class="mt-2 text-ink/75">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Voter Resources — Ulster County Board of Elections -->
  <section id="voter-resources" class="bg-white border-t border-slate-200">
    <div class="container-narrow py-14 lg:py-20">
      <div class="flex items-start gap-4 mb-6">
        <span class="shrink-0 mt-1 w-10 h-10 rounded-full bg-[#012566] flex items-center justify-center text-white text-lg">🏛</span>
        <div>
          <p class="text-xs font-heading font-bold uppercase tracking-widest text-[#D60F29] mb-1">Official County Resources</p>
          <h2 class="text-2xl lg:text-3xl font-display font-extrabold text-[#012566] text-balance">
            Voter Resources — Ulster County Board of Elections
          </h2>
        </div>
      </div>

      <p class="text-ink/80 leading-relaxed mb-8 max-w-2xl">
        For where to vote, early voting, and absentee/mail ballots, visit the official Ulster County Board of Elections.
        The links below are official county resources maintained by the Board of Elections — not campaign materials.
      </p>

      <div class="grid sm:grid-cols-2 gap-4">
        {[
          { label: 'Voter Info & Resources',           url: 'https://elections.ulstercountyny.gov/voter-resources/',    desc: 'General voter information and resources from the Board of Elections.' },
          { label: 'Early Voting Information',          url: 'https://elections.ulstercountyny.gov/early-voting/',       desc: 'Dates, locations, and hours for early voting in Ulster County.' },
          { label: 'Voting Instructions',               url: 'https://elections.ulstercountyny.gov/voting-instructions/', desc: 'Official instructions for casting your ballot.' },
          { label: 'Request a Ballot (Absentee/Mail)',  url: 'https://elections.ulstercountyny.gov/request-a-ballot/',   desc: 'Apply for an absentee or mail-in ballot.' },
          { label: 'Voter Info Lookup / Where to Vote', url: 'https://vic.ntsdata.com/home/ulster',                      desc: 'Look up your polling place and registration status.' },
          { label: 'Board of Elections — Main Site',    url: 'https://elections.ulstercountyny.gov',                     desc: 'Ulster County Board of Elections official website.' },
        ].map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start gap-3 p-4 rounded-xl border border-slate-200 hover:border-[#012566] hover:shadow-soft transition-all group"
          >
            <span class="shrink-0 mt-0.5 text-[#D60F29]">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </span>
            <div>
              <p class="font-heading font-bold text-sm text-[#012566] group-hover:text-[#D60F29] transition-colors leading-tight">{link.label}</p>
              <p class="mt-0.5 text-xs text-ink/60 leading-snug">{link.desc}</p>
            </div>
          </a>
        ))}
      </div>

      <p class="mt-6 text-xs text-ink/50 italic">
        These links go to the official Ulster County Board of Elections website and are not affiliated with or controlled by this campaign.
      </p>
    </div>
  </section>

  <WriteInBlock tone="navy" />
</BaseLayout>
