---
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteInBlock from '../components/WriteInBlock.astro';
import { site } from '../data/site';
import { webPage, breadcrumb } from '../lib/schema';

const path = '/issues';
const schema = webPage({
  name: 'Five Core Priorities',
  description: `${site.candidate.name}'s five core priorities for ${site.candidate.office}: fiscal responsibility, supporting our staff, communication & transparency, infrastructure, and water.`,
  path,
  author: true,
  extraNodes: [
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'Priorities', path },
    ]),
  ],
});

// Five pillars (content pack v2 — replaces v1 pillars; Meghann approves before launch).
const pillars = [
  {
    n: 1,
    title: 'Fiscal Responsibility',
    lede: 'Responsible budgeting builds community trust.',
    body: `Taxpayers deserve to understand how their money is being invested. That means clear budgets written in plain language, long-term planning instead of year-to-year patching, and prioritizing the projects that provide lasting value. Responsible investment protects taxpayers today and leaves the town stronger tomorrow.`,
  },
  {
    n: 2,
    title: 'Supporting Our Staff',
    lede: 'Strong communities are built by supported employees.',
    body: `Town government cannot function effectively when key positions sit vacant. Supporting our staff means real attention to recruitment and retention, addressing overdue union contracts, and building a workplace culture rooted in respect and collaboration. When we trust good people and support them, they do extraordinary things for their neighbors — and caring for our employees ultimately benefits every resident.`,
  },
  {
    n: 3,
    title: 'Communication & Transparency',
    lede: 'Government should be accessible.',
    body: `An open door. Returned phone calls. Clear explanations. Sharing information before people have to ask for it. Transparency isn't a single policy — it's a habit of consistent, respectful communication that earns trust over time.`,
  },
  {
    n: 4,
    title: 'Infrastructure',
    lede: 'Taking care of what we already have.',
    body: `Town buildings, roads, equipment, public spaces, and the environments our employees work in every day. Maintaining infrastructure isn't just repairing buildings — it's protecting the investments this community has already made.`,
  },
  {
    n: 5,
    title: 'Water',
    lede: "Protecting one of Woodstock's most important resources.",
    body: `Water quality, including PFAS, deserves careful attention: education, scientific guidance, practical solutions, and long-term planning. I won't pretend there are easy answers here. What I will commit to is thoughtful, informed leadership that communicates openly as new information becomes available.`,
  },
];
---

<BaseLayout title="Priorities" description={`${site.candidate.name}'s five core priorities for Woodstock.`} schema={schema}>
  <section class="bg-navy text-white">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">The foundation</p>
      <h1 class="text-4xl lg:text-5xl font-display font-extrabold text-white text-balance">Five Core Priorities</h1>
      <p class="mt-4 text-lg text-white/70 max-w-2xl mx-auto">
        A strong community begins with a strong foundation. These five priorities are where that
        foundation starts — shaped by listening, and grounded in how our town actually works.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-narrow py-14 lg:py-20 space-y-12 text-lg text-ink/80 leading-relaxed">
      {pillars.map((p) => (
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="w-9 h-9 rounded-full bg-red text-white font-display font-extrabold flex items-center justify-center shrink-0">{p.n}</span>
            <h2 class="text-2xl lg:text-3xl font-display font-extrabold text-navy">{p.title}</h2>
          </div>
          <p class="font-heading font-bold text-navy">{p.lede}</p>
          <p class="mt-2">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Vision close -->
  <section class="bg-cream">
    <div class="container-narrow py-14 lg:py-20 text-lg text-ink/80 leading-relaxed">
      <div class="section-divider mb-5"></div>
      <h2 class="text-2xl lg:text-3xl font-display font-extrabold text-navy mb-4">A vision worth building together</h2>
      <p>
        Woodstock has always been shaped by creativity, compassion, independence, and community. Our
        responsibility isn't simply to preserve what makes this town special — it's to strengthen it. We can
        honor the generations who built Woodstock while embracing thoughtful ideas that prepare us for what's
        ahead.
      </p>
      <p class="mt-4">
        This campaign is about balance: respecting history while planning ahead. Supporting employees while
        serving taxpayers. Protecting our environment while maintaining our infrastructure. Listening before
        leading. Working together instead of growing further apart.
      </p>
      <p class="mt-4 font-display font-bold text-navy">We are not running against someone — we are running for Woodstock.</p>
    </div>
  </section>

  <WriteInBlock tone="light" />
</BaseLayout>
