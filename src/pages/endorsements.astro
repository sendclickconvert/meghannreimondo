---
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteInBlock from '../components/WriteInBlock.astro';
import { site, ENDORSEMENTS } from '../data/site';
import { webPage, breadcrumb } from '../lib/schema';

const path = '/endorsements';
// WebPage ONLY — deliberately no review or rating schema of any kind.
const schema = webPage({
  name: 'Endorsements',
  description: `Endorsements for ${site.candidate.name}, write-in candidate for ${site.candidate.office}.`,
  path,
  extraNodes: [
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'Endorsements', path },
    ]),
  ],
});
---

<BaseLayout title="Endorsements" description={`Endorsements for ${site.candidate.name}.`} schema={schema}>
  <section class="bg-navy text-white">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">Who's backing Meghann</p>
      <h1 class="text-4xl lg:text-5xl font-display font-extrabold text-white">Endorsements</h1>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-narrow py-14 lg:py-20">
      <div class="space-y-10">
        {ENDORSEMENTS.map((e) => (
          <article class="card">
            <!-- Pull quote -->
            <blockquote class="relative pl-5 border-l-4 border-red">
              <p class="text-lg lg:text-xl font-display font-semibold text-navy leading-snug">
                “{e.pullQuote}”
              </p>
            </blockquote>

            <!-- Attribution -->
            <div class="mt-5 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-navy text-white flex items-center justify-center font-display font-bold">
                {e.name.split(' ').map((n) => n[0]).join('')}
              </div>
              <div>
                <p class="font-heading font-bold text-navy leading-tight">{e.name}</p>
                <p class="text-sm text-ink/70 leading-tight">{e.role}</p>
              </div>
            </div>

            <!-- Full letter (collapsible) -->
            <details class="mt-6 group">
              <summary class="cursor-pointer font-heading font-semibold text-sm text-red hover:underline list-none inline-flex items-center gap-1.5">
                Read the full letter
                <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="prose-measure mt-4 pt-4 border-t border-slate-200 space-y-4 text-ink/85 leading-relaxed">
                <p class="text-sm text-ink/60 font-heading">Letter of Endorsement{e.date ? ` · ${e.date}` : ''}</p>
                {e.letter.map((p) => <p>{p}</p>)}
                <p class="font-heading text-navy">
                  {e.signoff && <><span class="font-semibold">{e.signoff}</span><br /></>}
                  <span class="font-semibold">{e.signature[0]}</span>
                  {e.signature.slice(1).map((line) => <><br /><span class="font-normal text-ink/70 text-sm">{line}</span></>)}
                </p>
              </div>
            </details>
          </article>
        ))}
      </div>

      <p class="mt-10 text-center text-sm text-ink/60">
        Endorsements are listed only after each endorser has confirmed permission.
      </p>
    </div>
  </section>

  <!-- Endorsement submission form -->
  <section class="bg-cream border-t border-slate-200">
    <div class="container-narrow py-14 lg:py-20">
      <div class="max-w-2xl mx-auto">
        <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">Add Your Voice</p>
        <h2 class="text-2xl lg:text-3xl font-display font-extrabold text-navy mb-3">Submit an Endorsement</h2>
        <p class="text-ink/75 mb-8">
          Support Meghann? Share why. Submitted endorsements are reviewed by the campaign before they appear on the site.
        </p>

        <!-- Success state (hidden until submit) -->
        <div id="endorse-success" class="hidden card bg-white border-l-4 border-red text-center py-10">
          <p class="text-2xl mb-2">✅</p>
          <p class="font-display font-bold text-lg text-navy">Thank you!</p>
          <p class="mt-1 text-ink/75">Your endorsement has been received and will be reviewed by the campaign.</p>
        </div>

        <!-- Form -->
        <form id="endorse-form" novalidate class="card bg-white space-y-5">

          <div class="grid sm:grid-cols-2 gap-5">
            <!-- Full Name -->
            <div>
              <label for="endorse-name" class="block text-sm font-heading font-semibold text-navy mb-1.5">
                Full Name <span class="text-red">*</span>
              </label>
              <input
                id="endorse-name"
                name="fullName"
                type="text"
                required
                autocomplete="name"
                placeholder="Jane Smith"
                class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-ink placeholder:text-ink/40 focus:outline-none focus:ring-2 focus:ring-navy/40 focus:border-navy transition"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="endorse-email" class="block text-sm font-heading font-semibold text-navy mb-1.5">
                Email <span class="text-red">*</span>
              </label>
              <input
                id="endorse-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="jane@example.com"
                class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-ink placeholder:text-ink/40 focus:outline-none focus:ring-2 focus:ring-navy/40 focus:border-navy transition"
              />
            </div>
          </div>

          <!-- Town / Neighborhood -->
          <div>
            <label for="endorse-neighborhood" class="block text-sm font-heading font-semibold text-navy mb-1.5">
              Town / Neighborhood <span class="text-xs font-normal text-ink/50">(optional)</span>
            </label>
            <input
              id="endorse-neighborhood"
              name="neighborhood"
              type="text"
              autocomplete="address-level2"
              placeholder="Woodstock, NY"
              class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-ink placeholder:text-ink/40 focus:outline-none focus:ring-2 focus:ring-navy/40 focus:border-navy transition"
            />
          </div>

          <!-- Endorsement text -->
          <div>
            <label for="endorse-text" class="block text-sm font-heading font-semibold text-navy mb-1.5">
              Your Endorsement <span class="text-red">*</span>
            </label>
            <textarea
              id="endorse-text"
              name="endorsement"
              required
              rows="5"
              placeholder="Share why you support Meghann…"
              class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-ink placeholder:text-ink/40 focus:outline-none focus:ring-2 focus:ring-navy/40 focus:border-navy transition resize-y"
            ></textarea>
          </div>

          <!-- Mobile Phone -->
          <div>
            <label for="phone" class="block text-sm font-heading font-semibold text-navy mb-1.5">
              Mobile Phone <span class="text-xs font-normal text-ink/50">(optional)</span>
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              inputmode="tel"
              placeholder="(845) 555-0100"
              class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-ink placeholder:text-ink/40 focus:outline-none focus:ring-2 focus:ring-navy/40 focus:border-navy transition"
            />
            <p id="phone-error" class="hidden mt-1 text-sm text-red font-semibold">Please enter a mobile number to receive text updates.</p>
          </div>

          <!-- SMS opt-in -->
          <div class="flex items-start gap-3 p-4 rounded-lg bg-cream border border-slate-200">
            <input
              id="smsOptIn"
              name="smsOptIn"
              type="checkbox"
              class="mt-0.5 shrink-0 w-4 h-4 rounded border-slate-300 accent-[#012566] cursor-pointer"
            />
            <div>
              <label for="smsOptIn" class="text-sm text-ink/80 leading-snug cursor-pointer">
                Yes — text me campaign updates. By checking this box I give my express written consent to receive recurring automated text messages (SMS/MMS) from Friends of Meghann Reimondo at the mobile number provided, including updates, events, and calls to action. Consent is not a condition of any purchase.
              </label>
              <p class="mt-2 text-xs text-ink/60 leading-snug">
                Message frequency varies based on campaign activity; you may receive multiple messages per week during peak campaign periods. Message and data rates may apply. Reply STOP to opt out at any time. Reply HELP for help, or email <a href="mailto:meghann@meghannreimondo.com" class="underline hover:text-navy">meghann@meghannreimondo.com</a>. Carriers are not liable for delayed or undelivered messages. Mobile opt-in data and consent will not be shared with any third party for their own marketing or promotional purposes. See our <a href="/privacy-policy" class="underline hover:text-navy">Privacy Policy</a>.
              </p>
            </div>
          </div>

          <!-- Email opt-in -->
          <div class="flex items-start gap-3 p-4 rounded-lg bg-cream border border-slate-200">
            <input
              id="emailOptIn"
              name="emailOptIn"
              type="checkbox"
              class="mt-0.5 shrink-0 w-4 h-4 rounded border-slate-300 accent-[#012566] cursor-pointer"
            />
            <label for="emailOptIn" class="text-sm text-ink/80 leading-snug cursor-pointer">
              Yes — email me campaign updates from Friends of Meghann Reimondo. You can unsubscribe at any time using the link in any email.
            </label>
          </div>

          <!-- Publish consent checkbox -->
          <div class="flex items-start gap-3 p-4 rounded-lg bg-cream border border-slate-200">
            <input
              id="endorse-consent"
              name="publishConsent"
              type="checkbox"
              required
              class="mt-0.5 shrink-0 w-4 h-4 rounded border-slate-300 accent-[#012566] cursor-pointer"
            />
            <label for="endorse-consent" class="text-sm text-ink/80 leading-snug cursor-pointer">
              <span class="font-semibold text-navy">I give the Meghann Reimondo campaign permission to publish this endorsement with my name.</span>
              <span class="text-red ml-1">*</span>
            </label>
          </div>

          <!-- Error message -->
          <div id="endorse-error" class="hidden text-sm text-red font-semibold" role="alert"></div>

          <button
            type="submit"
            id="endorse-submit"
            class="btn-primary w-full text-base py-3"
          >
            Submit My Endorsement
          </button>

          <p class="text-xs text-ink/50 text-center leading-snug">
            Your submission goes to the campaign for review only. It will not appear on this page unless the campaign approves and manually adds it.
          </p>
        </form>
      </div>
    </div>
  </section>

  <WriteInBlock tone="light" />

<script>
  const form = document.getElementById('endorse-form') as HTMLFormElement | null;
  const successBox = document.getElementById('endorse-success');
  const errorBox = document.getElementById('endorse-error');
  const submitBtn = document.getElementById('endorse-submit') as HTMLButtonElement | null;
  const phoneError = document.getElementById('phone-error');

  function isValidUSPhone(val: string): boolean {
    return /^[\+]?[(]?[0-9]{3}[)]?[-\s\.]?[0-9]{3}[-\s\.]?[0-9]{4}$/.test(val.replace(/\s/g, ''));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errorBox) errorBox.classList.add('hidden');
    if (phoneError) phoneError.classList.add('hidden');

    const fullName     = (document.getElementById('endorse-name') as HTMLInputElement)?.value.trim();
    const email        = (document.getElementById('endorse-email') as HTMLInputElement)?.value.trim();
    const endorsement  = (document.getElementById('endorse-text') as HTMLTextAreaElement)?.value.trim();
    const consent      = (document.getElementById('endorse-consent') as HTMLInputElement)?.checked;
    const neighborhood = (document.getElementById('endorse-neighborhood') as HTMLInputElement)?.value.trim();
    const phone        = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
    const smsOptIn     = (document.getElementById('smsOptIn') as HTMLInputElement)?.checked ?? false;
    const emailOptIn   = (document.getElementById('emailOptIn') as HTMLInputElement)?.checked ?? false;

    if (!fullName || !email || !endorsement) {
      if (errorBox) { errorBox.textContent = 'Please fill in your name, email, and endorsement.'; errorBox.classList.remove('hidden'); }
      return;
    }
    if (!consent) {
      if (errorBox) { errorBox.textContent = 'Please check the permission box to continue.'; errorBox.classList.remove('hidden'); }
      return;
    }

    // SMS consent requires a valid phone number
    if (smsOptIn && (!phone || !isValidUSPhone(phone))) {
      if (phoneError) phoneError.classList.remove('hidden');
      document.getElementById('phone')?.focus();
      return;
    }

    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Submitting…'; }

    try {
      const res = await fetch('/api/endorse', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fullName, email, neighborhood, endorsement, publishConsent: true, phone, smsOptIn, emailOptIn }),
      });
      if (!res.ok) throw new Error('server_error');
      form.classList.add('hidden');
      successBox?.classList.remove('hidden');
    } catch {
      if (errorBox) { errorBox.textContent = 'Something went wrong. Please try again.'; errorBox.classList.remove('hidden'); }
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Submit My Endorsement'; }
    }
  });
</script>
</BaseLayout>
