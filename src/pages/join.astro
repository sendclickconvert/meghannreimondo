---
// /join — single-purpose opt-in lander.
// Minimal chrome: logo-only header, no nav, no exit popup, disclaimer-only footer.
// Form posts to INTEGRATIONS.optInEndpoint; falls back to success state when unset.
import { site, INTEGRATIONS } from '../data/site';
import { webPage, breadcrumb } from '../lib/schema';
import '../styles/global.css';

const path = '/join';
const schema = webPage({
  name: 'Count Me In — Commit My Vote',
  description: `Commit your write-in vote for ${site.candidate.name} for ${site.candidate.office}.`,
  path,
  extraNodes: [breadcrumb([{ name: 'Home', path: '/' }, { name: 'Count Me In', path }])],
});

const canonicalUrl = new URL(path, site.url).href;
const fullTitle = `Count Me In | ${site.candidate.name}`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={`Commit your write-in vote for ${site.candidate.name} for Woodstock Town Supervisor on November 3, 2026.`} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={`${site.url}/images/og-default.jpg`} />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body class="min-h-screen flex flex-col antialiased bg-cream">

  <!-- Logo-only header -->
  <header class="bg-white border-b border-slate-100 py-4">
    <div class="container-narrow flex justify-center">
      <a href="/" aria-label="Meghann Reimondo for Woodstock Town Supervisor — Home">
        <img src={site.brand.logo} alt="Meghann Reimondo — Write-In for Woodstock Town Supervisor" class="h-14 w-auto" width="56" height="56" />
      </a>
    </div>
  </header>

  <main class="flex-1">
    <!-- Hero -->
    <section class="bg-navy text-white">
      <div class="container-narrow py-14 lg:py-20 text-center">
        <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">Write-In · November 3, 2026</p>
        <h1 class="text-3xl lg:text-5xl font-display font-extrabold text-white text-balance leading-tight">
          YES — I'll Write In<br class="hidden sm:block" /> Meghann Reimondo
        </h1>
        <p class="mt-4 text-lg text-white/80 max-w-xl mx-auto italic">
          Woodstock deserves leadership that listens. Count me in.
        </p>
      </div>
    </section>

    <!-- Form -->
    <section class="bg-white">
      <div class="container-narrow py-14 lg:py-20 max-w-lg">
        <div class="card" id="join-form-card">
          <h2 class="font-display font-bold text-xl text-navy mb-6 text-center">I'm committing my vote</h2>

          <form
            id="join-form"
            class="space-y-4"
            novalidate
            data-endpoint={INTEGRATIONS.optInEndpoint}
          >
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="firstName" class="block text-sm font-heading font-semibold text-navy mb-1">
                  First Name <span class="text-red">*</span>
                </label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  required
                  autocomplete="given-name"
                  class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-navy/40"
                />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-heading font-semibold text-navy mb-1">
                  Last Name <span class="text-red">*</span>
                </label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  required
                  autocomplete="family-name"
                  class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-navy/40"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-heading font-semibold text-navy mb-1">
                Email <span class="text-red">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-navy/40"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-heading font-semibold text-navy mb-1">
                Phone <span class="text-ink/40 font-normal">(optional)</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-navy/40"
              />
            </div>

            <div>
              <label for="neighborhood" class="block text-sm font-heading font-semibold text-navy mb-1">
                Neighborhood <span class="text-ink/40 font-normal">(optional)</span>
              </label>
              <input
                type="text"
                id="neighborhood"
                name="neighborhood"
                placeholder="e.g. Woodstock, Bearsville, Wittenberg…"
                class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-navy/40"
              />
            </div>

            <!-- Required commitment checkbox -->
            <div class="pt-2 border-t border-slate-100">
              <label class="flex items-start gap-3 cursor-pointer">
                <input
                  type="checkbox"
                  id="commitVote"
                  name="commitVote"
                  required
                  class="mt-0.5 shrink-0 accent-navy"
                />
                <span class="text-sm text-ink/80 font-medium">
                  Yes, I plan to write in Meghann Reimondo for Town Supervisor.
                </span>
              </label>
            </div>

            <!-- SMS opt-in — NOT pre-checked, separate consent per TCPA -->
            <div>
              <label class="flex items-start gap-3 cursor-pointer">
                <input
                  type="checkbox"
                  id="smsOptIn"
                  name="smsOptIn"
                  class="mt-0.5 shrink-0 accent-navy"
                />
                <span class="text-xs text-ink/60 leading-relaxed">
                  Yes, I'd like to receive text updates from Friends of Meghann Reimondo.
                  Msg &amp; data rates may apply. Reply STOP to opt out, HELP for help.
                </span>
              </label>
            </div>

            <div id="join-error" class="hidden text-sm text-red font-semibold" role="alert"></div>

            <button type="submit" class="btn-primary w-full text-base py-3" id="join-submit">
              Count Me In &rarr;
            </button>

            <p class="text-xs text-ink/40 text-center">
              Your information is used only by the Friends of Meghann Reimondo campaign.
            </p>
          </form>
        </div>

        <!-- Thank-you state (shown after submit) -->
        <div id="join-thanks" class="hidden card text-center">
          <p class="text-3xl mb-3">🎉</p>
          <h2 class="font-display font-extrabold text-2xl text-navy">You're counted.</h2>
          <p class="mt-3 text-ink/75">
            Thank you — you're counted. Now help us find one more YES.
          </p>

          <!-- Share prompt -->
          <div class="mt-6 p-4 rounded-xl bg-cream">
            <p class="text-sm font-heading font-semibold text-navy mb-3">Share with a neighbor:</p>
            <div class="flex gap-2">
              <input
                id="share-url"
                type="text"
                readonly
                value={`${site.url}/join`}
                class="flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm bg-white"
                aria-label="Share link"
              />
              <button
                id="copy-link"
                class="btn-secondary px-4 py-2 text-sm shrink-0"
                aria-label="Copy link"
              >
                Copy
              </button>
            </div>
            <p id="copy-confirm" class="hidden mt-2 text-xs text-green-700 font-semibold">Link copied!</p>
          </div>

          <a href="/how-to-vote" class="mt-6 inline-block font-heading font-bold text-sm text-navy underline hover:text-red transition-colors">
            How to write me in on November 3 &rarr;
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Disclaimer-only footer -->
  <footer class="bg-navy text-white/60 text-center text-xs py-6 px-4">
    <p>Paid for by {site.legal.paidForBy}</p>
  </footer>

  <script>
    const form = document.getElementById('join-form') as HTMLFormElement | null;
    const thanks = document.getElementById('join-thanks');
    const errorBox = document.getElementById('join-error');
    const submitBtn = document.getElementById('join-submit') as HTMLButtonElement | null;

    document.getElementById('copy-link')?.addEventListener('click', async () => {
      const url = (document.getElementById('share-url') as HTMLInputElement)?.value;
      try { await navigator.clipboard.writeText(url); } catch { /* fallback */ }
      const confirm = document.getElementById('copy-confirm');
      confirm?.classList.remove('hidden');
      setTimeout(() => confirm?.classList.add('hidden'), 3000);
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorBox) errorBox.classList.add('hidden');

      // Client-side validation
      const data = Object.fromEntries(new FormData(form).entries());
      if (!data.firstName || !data.lastName || !data.email) {
        if (errorBox) { errorBox.textContent = 'Please fill in your first name, last name, and email.'; errorBox.classList.remove('hidden'); }
        return;
      }
      if (!data.commitVote) {
        if (errorBox) { errorBox.textContent = 'Please check the commitment box to continue.'; errorBox.classList.remove('hidden'); }
        return;
      }

      const endpoint = (form as HTMLFormElement & { dataset: { endpoint?: string } }).dataset.endpoint;
      if (endpoint) {
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Submitting…'; }
        try {
          await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ form: 'join-optin', ...data }),
          });
        } catch {
          if (errorBox) { errorBox.textContent = 'Something went wrong. Please try again.'; errorBox.classList.remove('hidden'); }
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Count Me In →'; }
          return;
        }
      }

      // Show thank-you
      document.getElementById('join-form-card')?.classList.add('hidden');
      thanks?.classList.remove('hidden');
      thanks?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>
</body>
</html>
