---
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteInBlock from '../components/WriteInBlock.astro';
import { site, isTodo } from '../data/site';
import { webPage, breadcrumb } from '../lib/schema';

const path = '/contact';
const schema = webPage({
  name: 'Contact',
  description: `Contact ${site.candidate.name}'s write-in campaign for ${site.candidate.office}.`,
  path,
  extraNodes: [breadcrumb([{ name: 'Home', path: '/' }, { name: 'Contact', path }])],
});

const email = isTodo(site.contact.email) ? null : site.contact.email;
const phone = isTodo(site.contact.phone) ? null : site.contact.phone;
---

<BaseLayout title="Contact" description={`Contact ${site.candidate.name}'s campaign.`} schema={schema}>
  <section class="bg-navy text-white">
    <div class="container-narrow py-14 lg:py-20 text-center">
      <p class="text-xs font-heading font-bold uppercase tracking-widest text-red mb-3">Get in touch</p>
      <h1 class="text-4xl lg:text-5xl font-display font-extrabold text-white">Get in Touch</h1>
      <p class="mt-4 text-lg text-white/70 max-w-2xl mx-auto">
        I meant it about the open door. Reach out with questions, ideas, or to get involved.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-narrow py-14 lg:py-20 max-w-xl">
      <div class="card mb-6 text-center">
        {email || phone ? (
          <div class="space-y-1">
            {email && <a href={`mailto:${email}`} class="block font-heading font-semibold text-navy hover:text-red">{email}</a>}
            {phone && <a href={`tel:${phone.replace(/[^0-9]/g, '')}`} class="block font-heading font-semibold text-navy hover:text-red">{phone}</a>}
          </div>
        ) : (
          <p class="font-display font-bold text-navy">[TODO — campaign email &amp; phone]</p>
        )}
        <p class="mt-4 text-sm text-ink/70">
          Follow along:
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="font-semibold text-navy hover:text-red underline">Facebook</a> &middot;
          <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="font-semibold text-navy hover:text-red underline">Instagram</a> &middot;
          <a href={site.social.bluesky} target="_blank" rel="noopener noreferrer" class="font-semibold text-navy hover:text-red underline">Bluesky</a> &middot;
          <a href={site.social.nextdoor} target="_blank" rel="noopener noreferrer" class="font-semibold text-navy hover:text-red underline">Nextdoor</a>
        </p>
      </div>

      <div class="card text-center">
        <p class="font-display font-bold text-lg text-navy">Send a message</p>
        <p class="mt-2 text-ink/75">Questions, ideas, or want to get involved? Email the campaign directly — every message is read.</p>
        <a
          href={`mailto:${site.contact.email}?subject=${encodeURIComponent('Message for the campaign')}`}
          class="btn-primary mt-6 inline-block"
          title="Email the campaign"
        >
          Email the Campaign &rarr;
        </a>
        <p class="mt-3 text-xs text-ink/50">Opens a pre-filled email to {site.contact.email}</p>
      </div>
    </div>
  </section>

  <WriteInBlock tone="light" />
</BaseLayout>
